# Public PostHog project token (phc_...). This value is embedded in browser code.
PUBLIC_POSTHOG_KEY=

# Optional PostHog ingestion host or first-party proxy. Defaults to US Cloud.
# PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
#
# After the Cloudflare Worker in cloudflare/posthog-proxy is attached to
# e.vrajmpatel.com, point production ingest at that host:
# PUBLIC_POSTHOG_HOST=https://e.vrajmpatel.com
