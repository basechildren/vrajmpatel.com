---
import BrandIcon from "./BrandIcon.astro";
interface Props { project?: string; }
const { project } = Astro.props;
---
<section id="contact" class="contact-block" aria-labelledby="contact-heading">
  <h2 id="contact-heading" class="section-title">{project ? "Discuss this project." : "Get in touch."}</h2>
  <a class="button-primary" href="https://www.linkedin.com/in/vrajmp/" target="_blank" rel="noopener noreferrer" data-ph-event="social_profile_clicked" data-ph-network="linkedin" data-ph-placement="contact"><BrandIcon network="linkedin" />Message me on LinkedIn</a>
</section>
