---
interface Props { project?: string; compact?: boolean; }
const { project, compact = false } = Astro.props;
---
<section id="contact" class:list={["contact-block", compact && "contact-block--compact"]} aria-labelledby="contact-heading" data-reveal>
  <div>
    <p class="eyebrow">Get in touch</p>
    <h2 id="contact-heading" class="section-title">{project ? "Discuss this project." : "Let’s talk about the work."}</h2>
    <p class="muted-copy">{project ? `Questions about ${project}, the tradeoffs, or my contribution?` : "For engineering opportunities or project questions."}</p>
  </div>
  <a class="button-primary" href="https://www.linkedin.com/in/vrajmp/" target="_blank" rel="noopener noreferrer" data-ph-event="social_profile_clicked" data-ph-network="linkedin" data-ph-placement="contact">Message me on LinkedIn</a>
</section>
