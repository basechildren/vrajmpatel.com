---
import type { CollectionEntry } from "astro:content";
import { organizationMarks } from "../data/organizationMarks";
import OrganizationMarks from "./OrganizationMarks.astro";

interface Props {
  entry: CollectionEntry<"experience">;
  variant?: "compact" | "detailed";
}

const { entry, variant = "detailed" } = Astro.props;
const mark = entry.data.organizationMark
  ? organizationMarks[entry.data.organizationMark]
  : undefined;
---

{
  variant === "compact" ? (
    <article id={entry.id} data-reveal data-timeline-entry class="experience-entry experience-entry--compact grid gap-2 border-t border-slate-200 py-5 sm:grid-cols-[11rem_1fr] sm:gap-7 sm:py-6 dark:border-slate-800">
      <div class="flex flex-wrap items-center gap-x-4 gap-y-2 sm:block">
        <OrganizationMarks
          {...mark}
          size="compact"
        />
        <p class="min-w-0 font-mono text-xs leading-5 text-slate-500 sm:mt-3 dark:text-slate-400">
          {entry.data.period}
        </p>
      </div>
      <div class="min-w-0">
        <h3 class="text-base font-semibold text-slate-950 dark:text-white sm:text-lg">
          {entry.data.title}
        </h3>
        <p class="mt-1 text-sm leading-6 text-slate-600 dark:text-slate-400">
          {entry.data.organization}
        </p>
        {entry.data.context && (
          <p class="mt-2 text-xs leading-5 text-slate-500 dark:text-slate-400">
            {entry.data.context}
          </p>
        )}
      </div>
    </article>
  ) : (
    <article id={entry.id} data-reveal data-timeline-entry class="experience-entry experience-entry--detailed grid gap-3 border-t border-slate-200 py-7 sm:grid-cols-[11rem_1fr] sm:gap-8 sm:py-9 dark:border-slate-800">
      <div class="flex flex-wrap items-center gap-x-4 gap-y-2 sm:block">
        <OrganizationMarks
          {...mark}
          size="regular"
        />
        <div class="min-w-0">
          <p class="font-mono text-xs leading-5 text-slate-500 sm:mt-4 dark:text-slate-400">
            {entry.data.period}
          </p>
          {entry.data.location && (
            <p class="mt-1 text-sm text-slate-500 sm:mt-2 dark:text-slate-400">
              {entry.data.location}
            </p>
          )}
        </div>
      </div>
      <div class="min-w-0">
        <h2 class="text-xl font-semibold tracking-tight text-slate-950 dark:text-white sm:text-2xl">
          {entry.data.title}
        </h2>
        <p class="mt-1 text-sm font-medium leading-6 text-slate-600 dark:text-slate-400 sm:text-base">
          {entry.data.organization}
        </p>
        {entry.data.context && (
          <p class="mt-2 text-sm leading-6 text-slate-500 dark:text-slate-400">
            {entry.data.context}
          </p>
        )}
        <div class="mt-4 text-[0.95rem] leading-7 text-slate-600 sm:mt-5 [&_a]:underline [&_a]:decoration-slate-300 [&_a]:underline-offset-4 [&_a]:hover:text-blue-700 [&_li]:pl-1 [&_strong]:font-semibold [&_strong]:text-slate-800 [&_ul]:list-disc [&_ul]:space-y-3 [&_ul]:pl-5 dark:text-slate-400 dark:[&_a]:decoration-slate-700 dark:[&_a]:hover:text-blue-400 dark:[&_strong]:text-slate-200">
          <slot />
        </div>
        {entry.data.relatedProject && <a class="text-link mt-3" href={`/projects/${entry.data.relatedProject}`}>Explore the related case study</a>}
        {entry.data.poster && (
          <div class="mt-6 text-sm font-medium">
            <a
              href={entry.data.poster}
              target="_blank"
              rel="noopener noreferrer"
              data-ph-event="outbound_link_clicked"
              data-ph-resource="poster"
              data-ph-project={entry.id}
              class="inline-flex min-h-11 items-center underline decoration-slate-300 underline-offset-4 hover:text-blue-700 focus-visible:rounded-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 dark:decoration-slate-700 dark:hover:text-blue-400"
            >
              {entry.data.posterLabel ?? "Research poster"}
            </a>
          </div>
        )}
      </div>
    </article>
  )
}

<script>
  const entries = document.querySelectorAll<HTMLElement>("[data-timeline-entry]");
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)");
  if ("IntersectionObserver" in window && !reduced.matches) {
    const observer = new IntersectionObserver(items => items.forEach(item => {
      if (item.isIntersecting) {
        (item.target as HTMLElement).dataset.timelineEntered = "true";
        observer.unobserve(item.target);
      }
    }), { threshold: .15 });
    entries.forEach(entry => observer.observe(entry));
  } else entries.forEach(entry => { entry.dataset.timelineEntered = "true"; });
</script>
<style>
  .experience-entry { position: relative; padding-left: 1.75rem; border-top-color: var(--line); }
  .experience-entry::before { content: ""; position: absolute; top: 0; bottom: 0; left: .28rem; width: 1px; background: var(--line); }
  .experience-entry::after { content: ""; position: absolute; top: 2.05rem; left: 0; width: .6rem; height: .6rem; border-radius: 50%; border: 1px solid var(--accent); background: var(--paper, #fff); box-shadow: 0 0 0 5px var(--paper, #fff); transition: background 450ms; }
  .experience-entry--compact::after { top: 1.6rem; }
  .experience-entry:focus-within::after { transition: none; }
  .experience-entry[data-timeline-entered="true"]::after { background: var(--accent); }
  .experience-entry h2, .experience-entry h3 { color: var(--ink); letter-spacing: -.025em; }
  .experience-entry :global(strong) { color: var(--ink); }
  .experience-entry h2 { font-family: var(--font-display, Georgia, serif); font-size: 1.9rem; font-weight: 400; }
  .experience-entry :global(details) { padding-block: .75rem; margin-top: 1.5rem; border-block: 1px solid var(--line); }
  .experience-entry :global(summary) { min-height: 44px; display: flex; align-items: center; justify-content: space-between; gap: 1rem; cursor: pointer; list-style: none; color: var(--ink); }
  .experience-entry :global(summary::-webkit-details-marker) { display: none; }
  .experience-entry :global(summary)::after { content: "↗"; color: var(--accent); font-family: var(--font-mono); transform: rotate(45deg); transition: transform 180ms; }
  .experience-entry :global(details[open] > summary)::after { transform: rotate(-135deg); }
  .experience-entry :global(summary:focus-visible) { outline: 2px solid var(--accent); outline-offset: 4px; }
  @media (min-width: 640px) { .experience-entry { padding-left: 2.25rem; } .experience-entry--detailed::after { top: 2.6rem; } .experience-entry--compact::after { top: 1.9rem; } }
  @media (prefers-reduced-motion: reduce) { .experience-entry::after { background: var(--accent); transition: none; } .experience-entry :global(summary)::after { transition: none; } }
  @media print { .experience-entry::before, .experience-entry::after { display: none; } .experience-entry { padding-left: 0; } }
</style>
