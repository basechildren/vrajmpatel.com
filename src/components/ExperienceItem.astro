---
import type { CollectionEntry } from "astro:content";
import { organizationMarks } from "../data/organizationMarks";
import OrganizationMarks from "./OrganizationMarks.astro";

interface Props {
  entry: CollectionEntry<"experience">;
  variant?: "compact" | "detailed";
}

const { entry, variant = "detailed" } = Astro.props;
const mark = entry.data.organizationMark
  ? organizationMarks[entry.data.organizationMark]
  : undefined;
---

{
  variant === "compact" ? (
    <article class="grid gap-2 border-t border-slate-200 py-6 sm:grid-cols-[9rem_1fr] sm:gap-7 dark:border-slate-800">
      <div>
        <OrganizationMarks
          {...mark}
          size="compact"
        />
        <p class="mt-3 font-mono text-xs leading-5 text-slate-500 dark:text-slate-400">
          {entry.data.period}
        </p>
      </div>
      <div>
        <h3 class="text-base font-semibold text-slate-950 dark:text-white sm:text-lg">
          {entry.data.title}
        </h3>
        <p class="mt-1 text-sm leading-6 text-slate-600 dark:text-slate-400">
          {entry.data.organization}
        </p>
      </div>
    </article>
  ) : (
    <article class="grid gap-4 border-t border-slate-200 py-9 sm:grid-cols-[11rem_1fr] sm:gap-8 dark:border-slate-800">
      <div>
        <OrganizationMarks
          {...mark}
          size="regular"
        />
        <p class="mt-4 font-mono text-xs leading-5 text-slate-500 dark:text-slate-400">
          {entry.data.period}
        </p>
        {entry.data.location && (
          <p class="mt-2 text-sm text-slate-500 dark:text-slate-400">
            {entry.data.location}
          </p>
        )}
      </div>
      <div class="min-w-0">
        <h2 class="text-xl font-semibold tracking-tight text-slate-950 dark:text-white sm:text-2xl">
          {entry.data.title}
        </h2>
        <p class="mt-1 text-sm font-medium leading-6 text-slate-600 dark:text-slate-400 sm:text-base">
          {entry.data.organization}
        </p>
        <div class="mt-5 text-[0.95rem] leading-7 text-slate-600 [&_a]:underline [&_a]:decoration-slate-300 [&_a]:underline-offset-4 [&_a]:hover:text-blue-700 [&_li]:pl-1 [&_strong]:font-semibold [&_strong]:text-slate-800 [&_ul]:list-disc [&_ul]:space-y-3 [&_ul]:pl-5 dark:text-slate-400 dark:[&_a]:decoration-slate-700 dark:[&_a]:hover:text-blue-400 dark:[&_strong]:text-slate-200">
          <slot />
        </div>
      </div>
    </article>
  )
}
