---
import type { CollectionEntry } from "astro:content";
import { organizationMarks } from "../data/organizationMarks";
import OrganizationMarks from "./OrganizationMarks.astro";

interface Props {
  entry: CollectionEntry<"experience">;
  variant?: "compact" | "detailed";
}

const { entry, variant = "detailed" } = Astro.props;
const mark = entry.data.organizationMark
  ? organizationMarks[entry.data.organizationMark]
  : undefined;
---

{
  variant === "compact" ? (
    <article class="grid gap-2 border-t border-slate-200 py-5 sm:grid-cols-[11rem_1fr] sm:gap-7 sm:py-6 dark:border-slate-800">
      <div class="flex flex-wrap items-center gap-x-4 gap-y-2 sm:block">
        <OrganizationMarks
          {...mark}
          size="compact"
        />
        <p class="min-w-0 font-mono text-xs leading-5 text-slate-500 sm:mt-3 dark:text-slate-400">
          {entry.data.period}
        </p>
      </div>
      <div class="min-w-0">
        <h3 class="text-base font-semibold text-slate-950 dark:text-white sm:text-lg">
          {entry.data.title}
        </h3>
        <p class="mt-1 text-sm leading-6 text-slate-600 dark:text-slate-400">
          {entry.data.organization}
        </p>
        {entry.data.context && (
          <p class="mt-2 text-xs leading-5 text-slate-500 dark:text-slate-400">
            {entry.data.context}
          </p>
        )}
      </div>
    </article>
  ) : (
    <article class="grid gap-3 border-t border-slate-200 py-7 sm:grid-cols-[11rem_1fr] sm:gap-8 sm:py-9 dark:border-slate-800">
      <div class="flex flex-wrap items-center gap-x-4 gap-y-2 sm:block">
        <OrganizationMarks
          {...mark}
          size="regular"
        />
        <div class="min-w-0">
          <p class="font-mono text-xs leading-5 text-slate-500 sm:mt-4 dark:text-slate-400">
            {entry.data.period}
          </p>
          {entry.data.location && (
            <p class="mt-1 text-sm text-slate-500 sm:mt-2 dark:text-slate-400">
              {entry.data.location}
            </p>
          )}
        </div>
      </div>
      <div class="min-w-0">
        <h2 class="text-xl font-semibold tracking-tight text-slate-950 dark:text-white sm:text-2xl">
          {entry.data.title}
        </h2>
        <p class="mt-1 text-sm font-medium leading-6 text-slate-600 dark:text-slate-400 sm:text-base">
          {entry.data.organization}
        </p>
        {entry.data.context && (
          <p class="mt-2 text-sm leading-6 text-slate-500 dark:text-slate-400">
            {entry.data.context}
          </p>
        )}
        <div class="mt-4 text-[0.95rem] leading-7 text-slate-600 sm:mt-5 [&_a]:underline [&_a]:decoration-slate-300 [&_a]:underline-offset-4 [&_a]:hover:text-blue-700 [&_li]:pl-1 [&_strong]:font-semibold [&_strong]:text-slate-800 [&_ul]:list-disc [&_ul]:space-y-3 [&_ul]:pl-5 dark:text-slate-400 dark:[&_a]:decoration-slate-700 dark:[&_a]:hover:text-blue-400 dark:[&_strong]:text-slate-200">
          <slot />
        </div>
        {entry.data.poster && (
          <div class="mt-6 text-sm font-medium">
            <a
              href={entry.data.poster}
              target="_blank"
              rel="noopener noreferrer"
              data-ph-event="outbound_link_clicked"
              data-ph-resource="poster"
              data-ph-project={entry.id}
              class="inline-flex min-h-11 items-center underline decoration-slate-300 underline-offset-4 hover:text-blue-700 focus-visible:rounded-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 dark:decoration-slate-700 dark:hover:text-blue-400"
            >
              {entry.data.posterLabel ?? "Research poster"}
            </a>
          </div>
        )}
      </div>
    </article>
  )
}
