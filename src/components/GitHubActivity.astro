---
import snapshotJson from "../data/githubActivitySnapshot.json";
import {
  accountFor,
  activityColors,
  activityLabel,
  activitySource,
  formattedRefreshTime,
  isGitHubActivityData,
  monthMarkers,
} from "../lib/githubActivity";

if (!isGitHubActivityData(snapshotJson)) {
  throw new Error("The checked-in GitHub activity snapshot is invalid");
}

const data = snapshotJson;
const personal = accountFor(data, "personal");
const academic = accountFor(data, "academic");
const markers = monthMarkers(data.days);
const weekCount = Math.ceil(data.days.length / 7);
const calendarDateFormatter = new Intl.DateTimeFormat("en-US", {
  month: "long",
  day: "numeric",
  year: "numeric",
  timeZone: "UTC",
});
const calendarStart = calendarDateFormatter.format(
  new Date(`${data.range.from}T00:00:00Z`),
);
const calendarEnd = calendarDateFormatter.format(
  new Date(`${data.range.to}T00:00:00Z`),
);

const cellStyle = (day: (typeof data.days)[number]) => {
  const colors = activityColors(day);
  return `--personal-color:${colors.personal};--academic-color:${colors.academic}`;
};
---

<div
  class="mt-7"
  data-github-activity
  data-ph-component="github_activity"
>
  <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
    <p class="text-lg font-semibold tracking-tight text-slate-950 dark:text-white">
      <span data-activity-total>{data.totalContributions}</span> contributions across two accounts
    </p>
    <p class="font-mono text-xs leading-5 text-slate-500 dark:text-slate-400" data-activity-status>
      Last synced <time datetime={data.generatedAt} data-activity-sync-time>{formattedRefreshTime(data.generatedAt)}</time>
    </p>
  </div>

  <dl class="mt-6 grid border-y border-slate-200 sm:grid-cols-2 dark:border-slate-800">
    <div class="py-5 sm:pr-6">
      <dt class="flex items-center gap-2 text-sm font-medium text-slate-800 dark:text-slate-200">
        <span class="github-activity-key github-activity-key--personal" aria-hidden="true"></span>
        Personal
      </dt>
      <dd class="mt-2 flex items-baseline justify-between gap-4">
        <a class="inline-flex min-h-11 items-center text-sm underline decoration-slate-300 underline-offset-4 hover:text-blue-700 focus-visible:rounded-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 dark:decoration-slate-700 dark:hover:text-blue-400" href={personal.url} target="_blank" rel="noopener noreferrer" data-ph-event="social_profile_clicked" data-ph-network="github" data-ph-account="personal" data-ph-placement="github_activity">
          @{personal.login}
        </a>
        <span class="font-mono text-xs text-slate-500 dark:text-slate-400"><span data-account-total="personal">{personal.totalContributions}</span> contributions</span>
      </dd>
    </div>
    <div class="border-t border-slate-200 py-5 sm:border-l sm:border-t-0 sm:pl-6 dark:border-slate-800">
      <dt class="flex items-center gap-2 text-sm font-medium text-slate-800 dark:text-slate-200">
        <span class="github-activity-key github-activity-key--academic" aria-hidden="true"></span>
        Academic
      </dt>
      <dd class="mt-2 flex items-baseline justify-between gap-4">
        <a class="inline-flex min-h-11 items-center text-sm underline decoration-slate-300 underline-offset-4 hover:text-blue-700 focus-visible:rounded-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 dark:decoration-slate-700 dark:hover:text-blue-400" href={academic.url} target="_blank" rel="noopener noreferrer" data-ph-event="social_profile_clicked" data-ph-network="github" data-ph-account="academic" data-ph-placement="github_activity">
          @{academic.login}
        </a>
        <span class="font-mono text-xs text-slate-500 dark:text-slate-400"><span data-account-total="academic">{academic.totalContributions}</span> contributions</span>
      </dd>
    </div>
  </dl>

  <div class="mt-7" data-activity-calendar>
    <p id="activity-calendar-summary" class="sr-only">
      Public contribution calendar from {calendarStart} through {calendarEnd}.
      {data.totalContributions} contributions across both accounts:
      {personal.totalContributions} personal and {academic.totalContributions}
      academic. The visual grid distinguishes personal, academic, and overlapping
      activity by color.
    </p>
    <p
      id="activity-scroll-hint"
      class="mb-3 text-xs leading-5 text-slate-500 sm:hidden dark:text-slate-400"
    >
      Latest weeks shown. Swipe horizontally for earlier activity.
    </p>
    <div
      class="overflow-x-auto rounded-md pb-3 outline-none focus-visible:ring-2 focus-visible:ring-blue-600 focus-visible:ring-offset-2 focus-visible:ring-offset-slate-50 dark:focus-visible:ring-offset-slate-950"
      tabindex="0"
      role="region"
      aria-label="Scrollable GitHub contribution calendar"
      aria-describedby="activity-calendar-summary activity-scroll-hint"
      data-activity-scroll
    >
      <div class="min-w-[50rem]" aria-hidden="true">
        <div
          class="github-activity-months ml-[2.35rem] grid h-5 text-[0.65rem] text-slate-500 dark:text-slate-400"
          style={`grid-template-columns:repeat(${weekCount},0.75rem);column-gap:3px`}
          data-month-labels
          aria-hidden="true"
        >
          {markers.map((marker) => (
            <span style={`grid-column:${marker.week} / span 3`}>{marker.label}</span>
          ))}
        </div>

        <div class="flex gap-[3px]">
          <div
            class="grid w-8 shrink-0 text-[0.6rem] leading-3 text-slate-500 dark:text-slate-400"
            style="grid-template-rows:repeat(7,0.75rem);row-gap:3px"
            aria-hidden="true"
          >
            <span class="col-start-1 row-start-2">Mon</span>
            <span class="col-start-1 row-start-4">Wed</span>
            <span class="col-start-1 row-start-6">Fri</span>
          </div>
          <ol
            class="github-activity-grid grid list-none"
            style={`grid-template-rows:repeat(7,0.75rem);grid-auto-flow:column;grid-auto-columns:0.75rem;gap:3px`}
            data-day-grid
          >
            {data.days.map((day) => (
              <li
                class="github-activity-cell h-3 w-3 rounded-[2px] border border-slate-200 dark:border-slate-800"
                data-source={activitySource(day)}
                data-date={day.date}
                style={cellStyle(day)}
                title={activityLabel(day)}
              ></li>
            ))}
          </ol>
        </div>
      </div>
    </div>
  </div>

  <div class="mt-4 flex flex-wrap items-center gap-x-5 gap-y-2 text-xs text-slate-500 dark:text-slate-400" aria-label="Account color key">
    <span class="inline-flex items-center gap-2"><span class="github-activity-key github-activity-key--personal" aria-hidden="true"></span>Personal</span>
    <span class="inline-flex items-center gap-2"><span class="github-activity-key github-activity-key--academic" aria-hidden="true"></span>Academic</span>
    <span class="inline-flex items-center gap-2"><span class="github-activity-key github-activity-key--both" aria-hidden="true"></span>Both on the same day</span>
  </div>
</div>

<script>
  const localTimeFormatter = new Intl.DateTimeFormat(undefined, {
    month: "short",
    day: "numeric",
    year: "numeric",
    hour: "numeric",
    minute: "2-digit",
    timeZoneName: "short",
  });
  const localTimeZone = Intl.DateTimeFormat().resolvedOptions().timeZone;

  const setupActivityCalendar = () => {
    for (const time of document.querySelectorAll<HTMLTimeElement>("[data-activity-sync-time]")) {
      const generatedAt = new Date(time.dateTime);
      if (Number.isNaN(generatedAt.valueOf())) continue;

      time.textContent = localTimeFormatter.format(generatedAt);
      time.title = localTimeZone
        ? `Shown in your local time (${localTimeZone})`
        : "Shown in your local time";
    }

    if (!window.matchMedia("(max-width: 639px)").matches) return;

    for (const scroller of document.querySelectorAll<HTMLElement>("[data-activity-scroll]")) {
      if (scroller.dataset.activityScrollInitialized === "true") continue;

      scroller.dataset.activityScrollInitialized = "true";
      requestAnimationFrame(() => {
        scroller.scrollLeft = Math.max(
          0,
          scroller.scrollWidth - scroller.clientWidth,
        );
      });
    }
  };

  setupActivityCalendar();
  document.addEventListener("astro:page-load", setupActivityCalendar);
</script>
