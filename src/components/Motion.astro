<script>
  import { reveal, onEnter } from "../lib/motion";
  document.querySelectorAll<HTMLElement>("[data-intro]").forEach(element => reveal(element, 6));
  onEnter("[data-reveal]", reveal);
  onEnter("[data-reveal-stagger]", element => {
    element.querySelectorAll<HTMLElement>(":scope > *").forEach((child, index) => reveal(child, 8, Math.min(index * .025, .1)));
  });
</script>
