---
interface Mark {
  logo: string;
  logoDark?: string;
  label: string;
  surface?: "princeton";
}

interface Props {
  marks?: readonly Mark[];
  size?: "compact" | "regular";
}

const { marks = [], size = "regular" } = Astro.props;
const railWidth = size === "compact" ? 160 : 176;
const railHeight = size === "compact" ? 64 : 72;
---

{
  marks.length > 0 && (
    <span
      class:list={[
        "flex shrink-0 gap-2",
        marks.length > 1 ? "flex-col items-start" : "items-center",
      ]}
      aria-hidden="true"
    >
      {
        marks.map(({ logo, logoDark, label, surface }) => (
          <span
            class:list={[
              "grid shrink-0 place-items-center rounded-md border",
              surface === "princeton"
                ? "border-[#e77500] bg-[#e77500] dark:border-[#e77500] dark:bg-[#e77500]"
                : "border-slate-200 bg-white dark:border-slate-700 dark:bg-slate-900",
              size === "compact" ? "h-16 w-40" : "h-[4.5rem] w-44",
            ]}
          >
            <img
              src={logo}
              alt=""
              width={railWidth}
              height={railHeight}
              title={label}
              decoding="async"
              class:list={[
                "max-h-full max-w-full object-contain",
                logoDark && "dark:hidden",
              ]}
            />
            {
              logoDark && (
                <img
                  src={logoDark}
                  alt=""
                  width={railWidth}
                  height={railHeight}
                  title={label}
                  decoding="async"
                  class="hidden max-h-full max-w-full object-contain dark:block"
                />
              )
            }
          </span>
        ))
      }
    </span>
  )
}
