---
interface Mark {
  logo: string;
  logoDark?: string;
  aspect?: "square" | "wide";
  scale?: number;
}

interface Props {
  marks?: readonly Mark[];
  size?: "compact" | "regular";
}

const { marks = [], size = "regular" } = Astro.props;
const imageSize = size === "compact" ? 36 : 48;
---

{
  marks.length > 0 && (
    <span class="flex shrink-0 items-center gap-2" aria-hidden="true">
      {
        marks.map(({ logo, logoDark, aspect = "square", scale = 1 }) => (
          <span
            class:list={[
              "grid shrink-0 place-items-center overflow-hidden rounded-sm bg-white",
              aspect === "wide"
                ? size === "compact" ? "h-9 w-16" : "h-12 w-20"
                : size === "compact" ? "h-9 w-9" : "h-12 w-12",
            ]}
          >
            <img
              src={logo}
              alt=""
              width={aspect === "wide" ? imageSize * 2 : imageSize}
              height={imageSize}
              loading="lazy"
              decoding="async"
              class:list={["h-full w-full object-contain", logoDark && "dark:hidden"]}
              style={scale === 1 ? undefined : "transform: scale(" + scale + ")"}
            />
            {
              logoDark && (
                <img
                  src={logoDark}
                  alt=""
                  width={aspect === "wide" ? imageSize * 2 : imageSize}
                  height={imageSize}
                  loading="lazy"
                  decoding="async"
                  class="hidden h-full w-full object-contain dark:block"
                  style={scale === 1 ? undefined : "transform: scale(" + scale + ")"}
                />
              )
            }
          </span>
        ))
      }
    </span>
  )
}
