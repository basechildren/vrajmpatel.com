<section class="privacy-settings instrument-frame ph-no-capture" aria-labelledby="browser-heading">
  <p class="eyebrow">Privacy settings</p>
  <h2 id="browser-heading">This browser</h2>
  <p class="privacy-settings-intro">Changes apply to this browser only.</p>

  <dl class="privacy-current" data-consent-status aria-label="Saved settings">
    <div><dt>Analytics</dt><dd data-consent-status-analytics>On</dd></div>
    <div><dt>Session replay</dt><dd data-consent-status-replay>On</dd></div>
  </dl>

  <form data-consent-form>
    <fieldset class="privacy-options">
      <legend class="sr-only">Analytics and replay for this browser</legend>
      <label class="privacy-option">
        <input type="checkbox" name="analytics" data-consent-analytics checked />
        <span><strong>Analytics</strong><span class="privacy-option-description">Pages you visit and how you interact with the site.</span></span>
      </label>
      <label class="privacy-option">
        <input type="checkbox" name="replay" data-consent-replay checked />
        <span><strong>Session replay</strong><span class="privacy-option-description">A replay of your visit with text entered in form fields hidden.</span></span>
      </label>
    </fieldset>
    <p class="hidden privacy-error" data-consent-error role="alert">Your browser couldn’t save these settings. Check that local storage is allowed for this site, then try again.</p>
    <button type="submit" data-consent-save disabled class="button-primary privacy-save">Save preferences</button>
    <p class="hidden privacy-saved" data-consent-saved role="status">Saved for this browser.</p>
  </form>
  <noscript><p class="privacy-saved">Enable JavaScript to save analytics and replay preferences in this browser.</p></noscript>
</section>

<script>
  import {
    CONSENT_CHANGE_EVENT,
    CONSENT_STORAGE_KEY,
    defaultConsent,
    parseStoredConsent,
    serializeConsent,
    type PostHogConsent,
  } from "../lib/posthogConsent";

  const statusLabel = (on: boolean) => (on ? "On" : "Off");

  const setupPrivacyControls = () => {
    const form = document.querySelector<HTMLFormElement>("[data-consent-form]");
    const analyticsInput = document.querySelector<HTMLInputElement>(
      "[data-consent-analytics]",
    );
    const replayInput = document.querySelector<HTMLInputElement>(
      "[data-consent-replay]",
    );
    const error = document.querySelector<HTMLElement>("[data-consent-error]");
    const saved = document.querySelector<HTMLElement>("[data-consent-saved]");
    const analyticsStatus = document.querySelector<HTMLElement>(
      "[data-consent-status-analytics]",
    );
    const replayStatus = document.querySelector<HTMLElement>(
      "[data-consent-status-replay]",
    );

    if (
      !form ||
      !analyticsInput ||
      !replayInput ||
      !error ||
      !saved ||
      !analyticsStatus ||
      !replayStatus
    ) {
      return;
    }

    if (form.dataset.consentReady === "true") return;
    form.dataset.consentReady = "true";

    const readConsent = () => {
      try { return parseStoredConsent(localStorage.getItem(CONSENT_STORAGE_KEY)) ?? defaultConsent(); }
      catch { return defaultConsent(); }
    };

    const syncStatus = (consent: PostHogConsent) => {
      analyticsStatus.textContent = statusLabel(consent.analytics);
      replayStatus.textContent = statusLabel(consent.replay);
    };

    const syncInputs = (consent: PostHogConsent) => {
      analyticsInput.checked = consent.analytics;
      replayInput.checked = consent.replay;
    };

    const persistAndNotify = (consent: PostHogConsent) => {
      localStorage.setItem(CONSENT_STORAGE_KEY, serializeConsent(consent));
      window.dispatchEvent(
        new CustomEvent<PostHogConsent>(CONSENT_CHANGE_EVENT, {
          detail: consent,
        }),
      );
      syncStatus(consent);
      error.classList.add("hidden");
      saved.classList.remove("hidden");
    };

    const stored = readConsent();
    syncInputs(stored);
    syncStatus(stored);

    form.addEventListener("change", () => {
      saved.classList.add("hidden");
      error.classList.add("hidden");
    });
    const saveButton = form.querySelector<HTMLButtonElement>("[data-consent-save]");
    if (saveButton) saveButton.disabled = false;

    form.addEventListener("submit", (event) => {
      event.preventDefault();
      const next: PostHogConsent = {
        analytics: analyticsInput.checked,
        replay: replayInput.checked,
      };

      try {
        persistAndNotify(next);
      } catch {
        error.classList.remove("hidden");
        saved.classList.add("hidden");
      }
    });
  };

  setupPrivacyControls();
  document.addEventListener("astro:page-load", setupPrivacyControls);
</script>

<style>
  .privacy-settings { padding: clamp(1.25rem, 4vw, 2rem); background: var(--paper-2); color: var(--ink); }
  h2 { margin-top: .5rem; color: var(--ink); font-size: 1.65rem; line-height: 1.25; font-weight: 550; letter-spacing: -.035em; }
  .privacy-settings-intro { max-width: 56ch; margin-top: .85rem; color: var(--copy); font-size: .9375rem; line-height: 1.75; }
  .privacy-current { display: flex; flex-wrap: wrap; gap: .65rem 1.5rem; margin-top: 1.4rem; padding-bottom: 1.25rem; border-bottom: 1px solid var(--line); font-size: .8125rem; }
  .privacy-current > div { display: flex; gap: .6rem; align-items: center; }
  .privacy-current dt { color: var(--copy); }
  .privacy-current dd { border: 1px solid var(--line); background: var(--paper); color: var(--ink); border-radius: 4px; padding: .1rem .5rem; font: .75rem/1.7 var(--font-mono); }
  .privacy-options { margin: .25rem 0 1.4rem; border: 0; padding: 0; min-width: 0; }
  .privacy-option { display: grid; grid-template-columns: 18px minmax(0,1fr); align-items: start; gap: .9rem; padding: 1.1rem 0; cursor: pointer; min-height: 44px; }
  .privacy-option + .privacy-option { border-top: 1px solid var(--line); }
  .privacy-option input { appearance: auto; width: 18px; height: 18px; margin: .15rem 0 0; accent-color: var(--accent); cursor: pointer; }
  .privacy-option strong { display: block; color: var(--ink); font-size: .9375rem; font-weight: 550; line-height: 1.5; }
  .privacy-option-description { display: block; margin-top: .3rem; color: var(--copy); font-size: .875rem; line-height: 1.7; }
  .privacy-option:focus-within { outline: 2px solid var(--accent); outline-offset: 5px; border-radius: 3px; }
  .privacy-save { min-height: 44px; cursor: pointer; }
  .privacy-save:disabled { opacity: .55; cursor: not-allowed; }
  .privacy-saved, .privacy-error { margin-top: 1rem; font-size: .8125rem; line-height: 1.75; color: var(--copy); }
  .privacy-error { color: #a3202b; margin-bottom: 1rem; }
  :global(.dark) .privacy-error { color: #ffabb2; }
</style>
