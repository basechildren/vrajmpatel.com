---
import type { ProofPoint } from "../data/recruiter";
interface Props { items: readonly ProofPoint[]; class?: string; columns?: 2 | 3; }
const { items, class: className, columns = 3 } = Astro.props;
---
<dl class:list={["proof-grid", columns === 2 ? "proof-grid--two" : "proof-grid--three", className]}>
  {items.map((item) => (
    <div data-reveal>
      <dt>{item.value}</dt>
      <dd>{item.label}</dd>
      {item.href && <dd><a class="text-link" href={item.href}>{item.linkLabel ?? "See evidence"}</a></dd>}
    </div>
  ))}
</dl>
