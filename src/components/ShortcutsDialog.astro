<dialog class="shortcuts-dialog ph-no-capture" id="keyboard-shortcuts" aria-labelledby="shortcuts-heading" aria-describedby="shortcuts-description" data-shortcuts-dialog>
  <div class="shortcuts-heading-row">
    <p class="eyebrow">Interface reference</p>
    <button type="button" class="shortcuts-close" aria-label="Close keyboard shortcuts" data-shortcuts-close>×</button>
  </div>
  <h2 id="shortcuts-heading">A few useful keys.</h2>
  <p id="shortcuts-description">Navigate from anywhere on the page. Shortcuts pause while you type or use a dialog.</p>
  <dl class="shortcuts-list">
    <div><dt><kbd>1</kbd> <kbd>2</kbd> <kbd>3</kbd> <kbd>4</kbd></dt><dd>Work / Experience / About / Brief</dd></div>
    <div><dt><kbd>g</kbd> then <kbd>h</kbd></dt><dd>Go home</dd></div>
    <div><dt><kbd>j</kbd> / <kbd>k</kbd></dt><dd>Next / previous case study section</dd></div>
    <div><dt><kbd>t</kbd></dt><dd>Switch color theme</dd></div>
    <div><dt><kbd>r</kbd></dt><dd>Open résumé PDF in a new tab</dd></div>
    <div><dt><kbd>?</kbd> / <kbd>Esc</kbd></dt><dd>Open / close this reference</dd></div>
  </dl>
  <label class="shortcuts-preference"><input type="checkbox" checked data-shortcuts-enabled /> Enable single-key shortcuts</label>
  <p class="shortcuts-note">You can turn these off. Every action is also available through a visible link or button.</p>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>("[data-shortcuts-dialog]");
  const preference = document.querySelector<HTMLInputElement>("[data-shortcuts-enabled]");
  if (dialog && preference) {
    let enabled = true;
    let previousFocus: HTMLElement | null = null;
    let homeChordAt = 0;
    try { enabled = localStorage.getItem("keyboard-shortcuts") !== "disabled"; } catch { /* The control still works without storage. */ }
    preference.checked = enabled;
    preference.addEventListener("change", () => {
      enabled = preference.checked;
      homeChordAt = 0;
      try { localStorage.setItem("keyboard-shortcuts", enabled ? "enabled" : "disabled"); } catch { /* Keep the current-page preference. */ }
    });
    const openDialog = () => {
      if (dialog.open) return;
      previousFocus = document.activeElement instanceof HTMLElement ? document.activeElement : null;
      dialog.showModal();
    };
    document.querySelectorAll<HTMLButtonElement>("[data-shortcuts-open]").forEach(button => {
      button.hidden = false;
      button.addEventListener("click", openDialog);
    });
    dialog.querySelector("[data-shortcuts-close]")?.addEventListener("click", () => dialog.close());
    dialog.addEventListener("close", () => previousFocus?.focus());
    dialog.addEventListener("click", event => {
      if (event.target !== dialog) return;
      const bounds = dialog.getBoundingClientRect();
      if (event.clientX < bounds.left || event.clientX > bounds.right || event.clientY < bounds.top || event.clientY > bounds.bottom) dialog.close();
    });
    window.addEventListener("blur", () => { homeChordAt = 0; });
    document.addEventListener("keydown", event => {
      if (!enabled || event.defaultPrevented || event.repeat || event.isComposing || event.ctrlKey || event.altKey || event.metaKey || (event.shiftKey && event.key !== "?")) { homeChordAt = 0; return; }
      const target = event.target;
      if (target instanceof Element && target.closest('input, textarea, select, [contenteditable]:not([contenteditable="false"]), [role="textbox"], [role="combobox"], [role="slider"]')) { homeChordAt = 0; return; }
      if (document.querySelector('dialog[open], [role="dialog"][aria-modal="true"]')) { homeChordAt = 0; return; }
      const key = event.key.toLowerCase();
      const goHome = key === "h" && homeChordAt > 0 && performance.now() - homeChordAt < 1000;
      homeChordAt = key === "g" ? performance.now() : 0;
      if (key === "g") { event.preventDefault(); return; }
      if (goHome) {
        event.preventDefault();
        // Use the normal link path so a pending terminal navigation is cancelled.
        const home = document.querySelector<HTMLAnchorElement>('.terminal-breadcrumb a[href="/"]');
        if (home) home.click();
        else window.location.assign("/");
        return;
      }
      if (key === "?") { event.preventDefault(); openDialog(); return; }
      if (/^[1-4]$/.test(key)) {
        event.preventDefault();
        document.querySelector<HTMLAnchorElement>(`[data-shortcut-route="${key}"]`)?.click();
      } else if (key === "t") {
        event.preventDefault();
        document.querySelector<HTMLButtonElement>("[data-theme-toggle]")?.click();
      } else if (key === "r") {
        event.preventDefault();
        document.querySelector<HTMLAnchorElement>("[data-shortcut-resume]")?.click();
      } else if (key === "j" || key === "k") {
        const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-case-navigation] a[href^="#"]')];
        if (!links.length) return;
        const current = Math.max(0, links.findIndex(link => link.getAttribute("aria-current") === "location"));
        const next = links[Math.max(0, Math.min(links.length - 1, current + (key === "j" ? 1 : -1)))];
        const section = document.getElementById(next.hash.slice(1));
        if (!section) return;
        event.preventDefault();
        next.click();
        const hadTabindex = section.hasAttribute("tabindex");
        if (!hadTabindex) section.setAttribute("tabindex", "-1");
        section.focus({ preventScroll: true });
        if (!hadTabindex) section.addEventListener("blur", () => section.removeAttribute("tabindex"), { once: true });
      }
    });
  }
</script>
