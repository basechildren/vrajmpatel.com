	<script>
		type PostHogClient = {
			capture: (eventName: string, properties?: Record<string, string>) => void;
		};

		const localHosts = new Set(["localhost", "127.0.0.1", "::1", "[::1]"]);
		const shouldTrack = () => !localHosts.has(window.location.hostname);
		const getPostHog = () =>
			(window as typeof window & { posthog?: PostHogClient }).posthog;

			let lastTrackedPage = "";
			const capturePageview = () => {
				const posthog = getPostHog();
				const currentPage = `${window.location.pathname}${window.location.search}`;
				if (posthog && shouldTrack() && currentPage !== lastTrackedPage) {
					posthog.capture("$pageview");
					lastTrackedPage = currentPage;
				}
			};

			// Capture traditional page loads and remain compatible with Astro's client router.
			capturePageview();
			document.addEventListener("astro:page-load", capturePageview);

		const eventNamePattern = /^[a-z][a-z0-9_]{0,63}$/;
		const propertyValuePattern = /^[a-z0-9][a-z0-9_-]{0,47}$/;
		const allowedPropertyNames = new Set([
			"kind",
			"network",
			"placement",
			"project",
			"resource",
		]);

		// Custom events are opt-in: only elements with data-ph-event are captured.
		document.addEventListener("click", (event) => {
			const posthog = getPostHog();
			if (!posthog || !shouldTrack() || !(event.target instanceof Element)) {
				return;
			}

			const trackedElement = event.target.closest<HTMLElement>("[data-ph-event]");
			if (!trackedElement) return;

			const eventName = trackedElement.dataset.phEvent?.trim();
			if (!eventName || !eventNamePattern.test(eventName)) return;

			const properties: Record<string, string> = {};
			for (const propertyName of allowedPropertyNames) {
				const datasetKey = `ph${propertyName[0].toUpperCase()}${propertyName.slice(1)}`;
				const value = trackedElement.dataset[datasetKey]?.trim();
				if (value && propertyValuePattern.test(value)) {
					properties[propertyName] = value;
				}
			}

			posthog.capture(eventName, properties);
		});
	</script>
