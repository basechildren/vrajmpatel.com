---
export interface Props {
  /** Public PostHog project token (phc_...). */
  projectKey?: string;
  /** Optional PostHog ingestion host or first-party proxy URL. */
  apiHost?: string;
}

import { isPostHogProjectToken } from "../lib/posthogPrivacy";

const DEFAULT_API_HOST = "https://us.i.posthog.com";
const UI_HOST = "https://us.posthog.com";

function normalizeApiHost(configuredHost?: string): string {
  if (!configuredHost?.trim()) return DEFAULT_API_HOST;

  try {
    const url = new URL(configuredHost.trim());
    if (
      url.protocol !== "https:" ||
      url.username ||
      url.password ||
      url.search ||
      url.hash
    ) {
      return DEFAULT_API_HOST;
    }

    return url.href.replace(/\/+$/, "");
  } catch {
    return DEFAULT_API_HOST;
  }
}

const configuredProjectKey = Astro.props.projectKey?.trim();
const projectKey = isPostHogProjectToken(configuredProjectKey)
  ? configuredProjectKey
  : undefined;
const apiHost = normalizeApiHost(
  Astro.props.apiHost ?? import.meta.env.PUBLIC_POSTHOG_HOST,
);
---

{projectKey ? (
  <meta
    name="posthog-config"
    data-project-key={projectKey}
    data-api-host={apiHost}
    data-ui-host={UI_HOST}
  />
  <script>
    import {
      CONSENT_CHANGE_EVENT,
      CONSENT_STORAGE_KEY,
      defaultConsent,
      hasBrowserPrivacySignal,
      hasTrackingGrant,
      isProductionAnalyticsHost,
      parseStoredConsent,
      type PostHogConsent,
    } from "../lib/posthogConsent";
    import { filterConsentedPostHogEvent } from "../lib/posthogPrivacy";

    void (async () => {
      const config = document.querySelector<HTMLMetaElement>(
        'meta[name="posthog-config"]',
      );
      const projectKey = config?.dataset.projectKey;
      const apiHost = config?.dataset.apiHost;
      const uiHost = config?.dataset.uiHost;

      if (
        !projectKey ||
        !apiHost ||
        !uiHost ||
        hasBrowserPrivacySignal() ||
        !isProductionAnalyticsHost(window.location.hostname)
      ) {
        return;
      }

      // Full posthog-js is required for session replay, heatmaps, web vitals,
      // and $pageleave. The slim.no-external bundle cannot load recorder.js.
      const { default: posthog } = await import("posthog-js");
      let analyticsPageviewSent = false;

      const readConsent = () =>
        parseStoredConsent(localStorage.getItem(CONSENT_STORAGE_KEY)) ??
        defaultConsent();

      const maskedRecording = {
        maskAllInputs: true,
        maskInputOptions: {
          email: true,
          password: true,
          textarea: true,
        },
      } as const;

      const applyConsent = (consent: PostHogConsent) => {
        posthog.set_config({
          autocapture: consent.analytics,
          capture_pageview: false,
          capture_pageleave: consent.analytics,
          capture_performance: consent.analytics,
          capture_heatmaps: consent.analytics,
          capture_dead_clicks: consent.analytics,
          disable_session_recording: !consent.replay,
        });

        if (hasTrackingGrant(consent)) {
          posthog.opt_in_capturing();
        } else {
          posthog.opt_out_capturing();
          analyticsPageviewSent = false;
        }

        if (consent.analytics) {
          (
            posthog as {
              webVitalsAutocapture?: { startIfEnabled?: () => void };
            }
          ).webVitalsAutocapture?.startIfEnabled?.();
        }

        if (consent.replay) {
          posthog.startSessionRecording({
            sampling: true,
            linked_flag: true,
          });
        } else if (posthog.sessionRecordingStarted()) {
          posthog.stopSessionRecording();
        }

        if (consent.analytics && !analyticsPageviewSent) {
          posthog.capture("$pageview", {
            $current_url: window.location.origin + window.location.pathname,
            $pathname: window.location.pathname,
          });
          analyticsPageviewSent = true;
        }
      };

      const initialConsent = readConsent();

      posthog.init(projectKey, {
        api_host: apiHost,
        ui_host: uiHost,
        person_profiles: "identified_only",
        autocapture: initialConsent.analytics,
        rageclick: false,
        capture_pageview: false,
        capture_pageleave: initialConsent.analytics,
        capture_performance: initialConsent.analytics,
        capture_heatmaps: initialConsent.analytics,
        capture_dead_clicks: initialConsent.analytics,
        capture_exceptions: false,
        disable_session_recording: !initialConsent.replay,
        disable_surveys: true,
        disable_scroll_properties: false,
        disableDeviceModel: true,
        disable_external_dependency_loading: false,
        advanced_disable_flags: true,
        save_campaign_params: true,
        save_referrer: true,
        disable_capture_url_hashes: true,
        respect_dnt: true,
        cross_subdomain_cookie: false,
        secure_cookie: true,
        session_recording: maskedRecording,
        before_send: (event) =>
          filterConsentedPostHogEvent(event, readConsent()),
        loaded: () => applyConsent(readConsent()),
      });

      let lastTrackedPathname = window.location.pathname;
      const capturePageview = () => {
        if (!readConsent().analytics) return;

        const pathname = window.location.pathname;
        if (pathname === lastTrackedPathname && analyticsPageviewSent) return;

        posthog.capture("$pageview", {
          $current_url: window.location.origin + pathname,
          $pathname: pathname,
        });
        lastTrackedPathname = pathname;
        analyticsPageviewSent = true;
      };

      document.addEventListener("astro:page-load", capturePageview);

      const allowedEvents = new Set([
        "outbound_link_clicked",
        "project_opened",
        "resume_clicked",
        "social_profile_clicked",
      ]);
      const propertyValuePattern = /^[a-z0-9][a-z0-9_-]{0,47}$/;
      const allowedPropertyNames = new Set([
        "kind",
        "network",
        "placement",
        "project",
        "resource",
      ]);

      document.addEventListener("click", (event) => {
        if (!readConsent().analytics) return;
        if (!(event.target instanceof Element)) return;

        const trackedElement =
          event.target.closest<HTMLElement>("[data-ph-event]");
        if (!trackedElement) return;

        const eventName = trackedElement.dataset.phEvent?.trim();
        if (!eventName || !allowedEvents.has(eventName)) return;

        const properties: Record<string, string> = {};
        for (const propertyName of allowedPropertyNames) {
          const datasetKey =
            "ph" + propertyName[0].toUpperCase() + propertyName.slice(1);
          const value = trackedElement.dataset[datasetKey]?.trim();
          if (value && propertyValuePattern.test(value)) {
            properties[propertyName] = value;
          }
        }

        posthog.capture(eventName, properties);
      });

      window.addEventListener(CONSENT_CHANGE_EVENT, (event) => {
        const consent = (event as CustomEvent<PostHogConsent>).detail;
        if (
          !consent ||
          typeof consent.analytics !== "boolean" ||
          typeof consent.replay !== "boolean"
        ) {
          return;
        }

        applyConsent(consent);
      });
    })();
  </script>
) : null}
