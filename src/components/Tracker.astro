---
export interface Props {
  /** Public PostHog project token (phc_...). */
  projectKey?: string;
  /** Optional PostHog ingestion host or first-party proxy URL. */
  apiHost?: string;
}

import { isPostHogProjectToken } from "../lib/posthogPrivacy";

const DEFAULT_API_HOST = "https://us.i.posthog.com";

function normalizeApiHost(configuredHost?: string): string {
  if (!configuredHost?.trim()) return DEFAULT_API_HOST;

  try {
    const url = new URL(configuredHost.trim());
    if (
      url.protocol !== "https:" ||
      url.username ||
      url.password ||
      url.search ||
      url.hash
    ) {
      return DEFAULT_API_HOST;
    }

    return url.href.replace(/\/+$/, "");
  } catch {
    return DEFAULT_API_HOST;
  }
}

const configuredProjectKey = Astro.props.projectKey?.trim();
const projectKey = isPostHogProjectToken(configuredProjectKey)
  ? configuredProjectKey
  : undefined;
const apiHost = normalizeApiHost(
  Astro.props.apiHost ?? import.meta.env.PUBLIC_POSTHOG_HOST,
);
---

{projectKey ? (
  <meta
    name="posthog-config"
    data-project-key={projectKey}
    data-api-host={apiHost}
  />
  <script>
    import { sanitizePostHogEvent } from "../lib/posthogPrivacy";

    void (async () => {
      const config = document.querySelector<HTMLMetaElement>(
        'meta[name="posthog-config"]',
      );
      const projectKey = config?.dataset.projectKey;
      const apiHost = config?.dataset.apiHost;
      const productionHosts = new Set([
        "vrajmpatel.com",
        "www.vrajmpatel.com",
      ]);
      const hasPrivacySignal =
        navigator.doNotTrack === "1" ||
        (navigator as Navigator & { globalPrivacyControl?: boolean })
          .globalPrivacyControl === true;

      if (
        !projectKey ||
        !apiHost ||
        hasPrivacySignal ||
        !productionHosts.has(window.location.hostname)
      ) {
        return;
      }

      const { default: posthog } = await import(
        "posthog-js/dist/module.slim.no-external"
      );
      posthog.init(projectKey, {
        api_host: apiHost,
        person_profiles: "never",
        autocapture: false,
        rageclick: false,
        capture_pageview: false,
        capture_pageleave: false,
        capture_performance: false,
        capture_heatmaps: false,
        capture_dead_clicks: false,
        capture_exceptions: false,
        disable_session_recording: true,
        disable_surveys: true,
        disable_scroll_properties: true,
        disableDeviceModel: true,
        disable_external_dependency_loading: true,
        advanced_disable_flags: true,
        save_campaign_params: false,
        save_referrer: false,
        disable_capture_url_hashes: true,
        respect_dnt: true,
        cross_subdomain_cookie: false,
        secure_cookie: true,
        before_send: sanitizePostHogEvent,
      });

      let lastTrackedPathname = "";
      const capturePageview = () => {
        const pathname = window.location.pathname;
        if (pathname === lastTrackedPathname) return;

        posthog.capture("$pageview", {
          $current_url: window.location.origin + pathname,
          $pathname: pathname,
        });
        lastTrackedPathname = pathname;
      };

      capturePageview();
      document.addEventListener("astro:page-load", capturePageview);

      const allowedEvents = new Set([
        "outbound_link_clicked",
        "project_opened",
        "resume_clicked",
        "social_profile_clicked",
      ]);
      const propertyValuePattern = /^[a-z0-9][a-z0-9_-]{0,47}$/;
      const allowedPropertyNames = new Set([
        "kind",
        "network",
        "placement",
        "project",
        "resource",
      ]);

      document.addEventListener("click", (event) => {
        if (!(event.target instanceof Element)) return;

        const trackedElement =
          event.target.closest<HTMLElement>("[data-ph-event]");
        if (!trackedElement) return;

        const eventName = trackedElement.dataset.phEvent?.trim();
        if (!eventName || !allowedEvents.has(eventName)) return;

        const properties: Record<string, string> = {};
        for (const propertyName of allowedPropertyNames) {
          const datasetKey =
            "ph" +
            propertyName[0].toUpperCase() +
            propertyName.slice(1);
          const value = trackedElement.dataset[datasetKey]?.trim();
          if (value && propertyValuePattern.test(value)) {
            properties[propertyName] = value;
          }
        }

        posthog.capture(eventName, properties);
      });
    })();
  </script>
) : null}
