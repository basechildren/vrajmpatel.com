---
import "../styles/global.css";
import "../styles/shell.css";
import Motion from "../components/Motion.astro";
import SiteHeader from "../components/SiteHeader.astro";
import StatusBar from "../components/StatusBar.astro";
import ShortcutsDialog from "../components/ShortcutsDialog.astro";
import Tracker from "../components/Tracker.astro";
import { profile } from "../data/profile";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogImageAlt?: string;
  schemaType?: "Person" | "WebPage";
  robots?: "index, follow" | "noindex, follow";
}

const {
  title = "Vraj Patel",
  description = "Systems integration engineer building backend and ML systems at CU Boulder.",
  ogImage = "/profile.jpg",
  ogImageAlt = "Portrait of Vraj Patel",
  schemaType = "WebPage",
  robots = "index, follow",
} = Astro.props;

const wideLayout = Astro.url.pathname === "/" || Astro.url.pathname.startsWith("/projects");
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const imageUrl = new URL(ogImage, Astro.site);
const person = {
  "@type": "Person",
  name: profile.name,
  url: "https://www.vrajmpatel.com",
  jobTitle: profile.role,
  worksFor: {
    "@type": "Organization",
    name: profile.employer.name,
    parentOrganization: {
      "@type": "CollegeOrUniversity",
      name: profile.employer.parent,
    },
  },
  alumniOf: {
    "@type": "CollegeOrUniversity",
    name: "University of Colorado Boulder",
  },
  sameAs: [
    "https://www.linkedin.com/in/vrajmp/",
    ...profile.githubProfiles.map(({ href }) => href),
  ],
};

const structuredData =
  schemaType === "Person"
    ? { "@context": "https://schema.org", ...person }
    : {
        "@context": "https://schema.org",
        "@type": "WebPage",
        name: title,
        description,
        url: canonicalUrl,
        author: person,
      };
---

<!DOCTYPE html>
<html lang="en" class="min-h-full">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Vraj Patel" />
    <meta name="robots" content={robots} />
    <meta
      name="theme-color"
      content="#faf9f6"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#0b0a11"
      media="(prefers-color-scheme: dark)"
    />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="Vraj Patel" />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:alt" content={ogImageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />

    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(structuredData)}
    ></script>
    <script is:inline>
      (() => {
        let savedTheme = null;
        try {
          savedTheme = localStorage.getItem("theme");
        } catch {
          // Storage can be blocked; the system preference still works.
        }
        const prefersDark = window.matchMedia(
          "(prefers-color-scheme: dark)",
        ).matches;
        const isDark = savedTheme === "dark" || (savedTheme !== "light" && prefersDark);
        document.documentElement.classList.toggle("dark", isDark);
        document.documentElement.style.colorScheme = isDark ? "dark" : "light";
      })();
    </script>
    <Motion />
    <Tracker
      projectKey={import.meta.env.PUBLIC_POSTHOG_KEY}
      apiHost={import.meta.env.PUBLIC_POSTHOG_HOST}
    />
  </head>
  <body
    class="site-body grid-paper"
  >
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[60] focus:rounded-md focus:bg-slate-950 focus:px-4 focus:py-2 focus:text-white focus:outline-none focus:ring-2 focus:ring-blue-600"
    >
      Skip to content
    </a>

    <SiteHeader />

    <main id="main" class:list={["site-main", { "site-main-wide": wideLayout }]}>
      <slot />
    </main>

    <footer class="site-footer print:hidden">
      <div
        class="site-footer-links"
      >
        <p class="footer-copyright">&copy; {new Date().getFullYear()} {profile.name} · {profile.location}</p>
        <nav aria-label="Footer links" class="footer-navigation">
          <a
            href="/privacy"
            class="inline-flex min-h-11 touch-manipulation items-center underline underline-offset-4 focus-visible:rounded-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-600"
          >Privacy</a>
          <a
            href="https://www.linkedin.com/in/vrajmp/"
            target="_blank"
            rel="noopener noreferrer"
            data-ph-event="social_profile_clicked"
            data-ph-network="linkedin"
            class="inline-flex min-h-11 items-center underline decoration-slate-300 underline-offset-4 hover:text-slate-950 focus-visible:rounded-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 dark:decoration-slate-700 dark:hover:text-white"
          >Contact on LinkedIn</a>
          {
            profile.githubProfiles.map(({ href, label, username }) => (
              <a
                href={href}
                target="_blank"
                rel="noopener noreferrer"
                data-ph-event="social_profile_clicked"
                data-ph-network="github"
                data-ph-account={username}
                class="inline-flex min-h-11 items-center underline decoration-slate-300 underline-offset-4 hover:text-slate-950 focus-visible:rounded-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 dark:decoration-slate-700 dark:hover:text-white"
              >{label}</a>
            ))
          }
        </nav>
      </div>
      <StatusBar />
    </footer>
    <ShortcutsDialog />
  </body>
</html>
