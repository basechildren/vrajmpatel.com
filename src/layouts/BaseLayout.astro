---
import "../styles/global.css";
import "../styles/shell.css";
import Motion from "../components/Motion.astro";
import SiteHeader from "../components/SiteHeader.astro";
import StatusBar from "../components/StatusBar.astro";
import ShortcutsDialog from "../components/ShortcutsDialog.astro";
import Tracker from "../components/Tracker.astro";
import { profile } from "../data/profile";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogImageAlt?: string;
  schemaType?: "Person" | "WebPage";
  robots?: "index, follow" | "noindex, follow";
}

const {
  title = "Vraj Patel",
  description = profile.description,
  ogImage = "/og/profile.png",
  ogImageAlt = "Vraj Patel — Software, Data and ML Engineering",
  schemaType = "WebPage",
  robots = "index, follow",
} = Astro.props;

const wideLayout = Astro.url.pathname === "/" || Astro.url.pathname.startsWith("/projects");
const homeLayout = Astro.url.pathname === "/";
const canonicalPath = Astro.url.pathname === "/404" ? "/404.html" : Astro.url.pathname.endsWith(".html") ? Astro.url.pathname : Astro.url.pathname.replace(/\/?$/, "/");
const canonicalUrl = new URL(canonicalPath, Astro.site);
const imageUrl = new URL(ogImage, Astro.site);
const personId = new URL("/#person", Astro.site).href;
const websiteId = new URL("/#website", Astro.site).href;
const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";
const markdownPath = pathname === "/" ? "/profile.md" : /^\/projects\/[^/]+$/.test(pathname) ? `${pathname}.md` : undefined;
const person = {
  "@id": personId,
  "@type": "Person",
  name: profile.name,
  url: new URL("/", Astro.site).href,
  description: profile.description,
  image: new URL("/profile.jpg", Astro.site).href,
  jobTitle: profile.role,
  knowsAbout: ["Software engineering", "Data engineering", "Backend systems", "Applied machine learning", "Model evaluation"],
  worksFor: {
    "@type": "Organization",
    name: profile.employer.name,
    parentOrganization: {
      "@type": "CollegeOrUniversity",
      name: profile.employer.parent,
    },
  },
  alumniOf: {
    "@type": "CollegeOrUniversity",
    name: "University of Colorado Boulder",
  },
  sameAs: [
    profile.linkedin,
    ...profile.githubProfiles.map(({ href }) => href),
  ],
};

const page = {
  "@id": `${canonicalUrl.href}#webpage`,
  "@type": schemaType === "Person" || pathname === "/about" ? "ProfilePage" : "WebPage",
  name: title,
  description,
  url: canonicalUrl.href,
  inLanguage: "en-US",
  isPartOf: { "@id": websiteId },
  author: { "@id": personId },
  ...(schemaType === "Person" || pathname === "/about" ? { mainEntity: { "@id": personId } } : {}),
};
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    person,
    { "@type": "WebSite", "@id": websiteId, name: profile.name, url: new URL("/", Astro.site).href, publisher: { "@id": personId } },
    page,
  ],
};
---

<!DOCTYPE html>
<html lang="en" class="min-h-full">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Vraj Patel" />
    <meta name="robots" content={robots} />
    <meta
      name="theme-color"
      content="#faf9f6"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#0b0a11"
      media="(prefers-color-scheme: dark)"
    />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="Vraj Patel" />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:alt" content={ogImageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="describedby" href="/llms.txt" />
    {markdownPath && <link rel="alternate" type="text/markdown" href={markdownPath} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />

    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(structuredData).replace(/</g, "\\u003c")}
    ></script>
    <script is:inline>
      (() => {
        let savedTheme = null;
        try {
          savedTheme = localStorage.getItem("theme");
        } catch {
          // Storage can be blocked; the system preference still works.
        }
        const prefersDark = window.matchMedia(
          "(prefers-color-scheme: dark)",
        ).matches;
        const isDark = savedTheme === "dark" || (savedTheme !== "light" && prefersDark);
        document.documentElement.classList.toggle("dark", isDark);
        document.documentElement.style.colorScheme = isDark ? "dark" : "light";
      })();
    </script>
    <Motion />
    <Tracker
      projectKey={import.meta.env.PUBLIC_POSTHOG_KEY}
      apiHost={import.meta.env.PUBLIC_POSTHOG_HOST}
    />
  </head>
  <body
    class="site-body grid-paper"
  >
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[60] focus:rounded-md focus:bg-slate-950 focus:px-4 focus:py-2 focus:text-white"
    >
      Skip to content
    </a>

    <SiteHeader />

    <main id="main" class:list={["site-main", { "site-main-wide": wideLayout, "site-main-home": homeLayout }]}>
      <slot />
    </main>

    <footer class="site-footer print:hidden">
      <div
        class="site-footer-links"
      >
        <p class="footer-copyright">&copy; {new Date().getFullYear()} {profile.name} · {profile.location}</p>
        <nav aria-label="Footer links" class="footer-navigation">
          <a
            href="/privacy/"
            class="inline-flex min-h-11 touch-manipulation items-center underline underline-offset-4 focus-visible:rounded-sm"
          >Privacy</a>
          <a
            href="https://www.linkedin.com/in/vrajmp/"
            target="_blank"
            rel="noopener noreferrer"
            data-ph-event="social_profile_clicked"
            data-ph-network="linkedin"
            class="inline-flex min-h-11 items-center underline decoration-slate-300 underline-offset-4 hover:text-slate-950 focus-visible:rounded-sm dark:decoration-slate-700 dark:hover:text-white"
          >LinkedIn</a>
          {
            profile.githubProfiles.map(({ href, label, username }) => (
              <a
                href={href}
                target="_blank"
                rel="noopener noreferrer"
                data-ph-event="social_profile_clicked"
                data-ph-network="github"
                data-ph-account={username}
                class="inline-flex min-h-11 items-center underline decoration-slate-300 underline-offset-4 hover:text-slate-950 focus-visible:rounded-sm dark:decoration-slate-700 dark:hover:text-white"
              >{label}</a>
            ))
          }
        </nav>
      </div>
      <StatusBar />
    </footer>
    <ShortcutsDialog />
  </body>
</html>
