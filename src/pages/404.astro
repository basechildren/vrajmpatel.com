---
import BaseLayout from "../layouts/BaseLayout.astro";
const routes = [
  { href: "/", label: "home/", description: "The overview" },
  { href: "/projects", label: "work/", description: "Selected case studies" },
  { href: "/experience", label: "experience/", description: "Roles and contributions" },
  { href: "/about", label: "about/", description: "Background and contact" },
  { href: "/brief", label: "brief/", description: "The recruiter brief" },
];
---
<BaseLayout title="Page not found — Vraj Patel" description="The page you requested is not available." robots="noindex, follow">
  <section class="not-found" aria-labelledby="not-found-heading">
    <p class="eyebrow">Exit status 404</p>
    <h1 id="not-found-heading">A path less <em>found.</em></h1>
    <p class="not-found-intro">That page is no longer here. There’s still plenty to explore.</p>
    <div class="error-terminal">
      <div class="terminal-title"><span class="terminal-dots" aria-hidden="true"><i></i><i></i><i></i></span><span>vraj-patel — zsh</span><span>404</span></div>
      <div class="terminal-body">
        <p class="terminal-error">zsh: no such file or directory: <span class="ph-no-capture" data-requested-path>/requested/path</span></p>
        <p class="terminal-command"><span aria-hidden="true">❯</span> ls ~/vraj-patel</p>
        <nav aria-label="Available pages" class="terminal-routes">
          {routes.map(({ href, label, description }) => <a href={href}><span>{label}</span><span class="route-description">{description}</span><span aria-hidden="true">↗</span></a>)}
        </nav>
      </div>
      <p class="terminal-footnote">Tip: press <kbd>g</kbd> then <kbd>h</kbd> to return home.</p>
    </div>
    <a href="/projects" class="text-link">View selected work <span aria-hidden="true">&nbsp;↗</span></a>
  </section>
</BaseLayout>
<script>
  const requestedPath = document.querySelector<HTMLElement>("[data-requested-path]");
  if (requestedPath) {
    try { requestedPath.textContent = decodeURIComponent(window.location.pathname); }
    catch { requestedPath.textContent = window.location.pathname; }
  }
</script>
<style>
  .not-found { max-width: 46rem; padding: 1rem 0 3rem; }
  h1 { margin-top: 1.1rem; color: var(--ink); font-size: clamp(2.5rem, 6vw, 4.5rem); font-weight: 500; line-height: 1.06; letter-spacing: -.05em; }
  h1 em { font-family: var(--font-display, Georgia, serif); font-weight: 400; color: var(--accent); }
  .not-found-intro { margin-top: 1.25rem; color: var(--copy); font-size: 1rem; line-height: 1.8; }
  .error-terminal { margin: 2.5rem 0 1.5rem; border: 1px solid var(--line); border-radius: 12px; background: var(--surface); overflow: hidden; box-shadow: 0 15px 45px #00000004; font: .75rem/1.7 var(--font-mono); }
  .terminal-title { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: .8rem 1.25rem; border-bottom: 1px solid var(--line); color: var(--muted); font-size: .625rem; background: var(--paper-2); }
  .terminal-dots { display: flex; gap: .35rem; }
  .terminal-dots i { width: .45rem; height: .45rem; border: 1px solid var(--muted); border-radius: 100%; opacity: .5; }
  .terminal-body { padding: 1.5rem 1.75rem; }
  .terminal-error { color: var(--copy); overflow-wrap: anywhere; }
  .terminal-error span { color: var(--ink); }
  .terminal-command { margin-top: 1.5rem; color: var(--ink); }
  .terminal-command > span { margin-right: .6rem; color: var(--accent); }
  .terminal-routes { margin-top: .8rem; }
  .terminal-routes a { display: grid; grid-template-columns: 7.5rem 1fr auto; align-items: center; gap: 1rem; min-height: 44px; color: var(--accent); }
  .terminal-routes a:hover { text-decoration: underline; text-underline-offset: 4px; }
  .terminal-routes a:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; border-radius: 2px; }
  .route-description { color: var(--muted); font-family: var(--font-sans); font-size: .75rem; }
  .terminal-footnote { padding: .75rem 1.75rem; border-top: 1px solid var(--line); color: var(--muted); font-size: .625rem; }
  kbd { color: var(--ink); }
  @media (max-width: 480px) {
    .terminal-body { padding: 1.25rem; }
    .terminal-routes a { grid-template-columns: 1fr auto; }
    .route-description { display: none; }
    .terminal-footnote { padding-inline: 1.25rem; }
  }
</style>
