---
import OrganizationMarks from "../components/OrganizationMarks.astro";
import GitHubActivity from "../components/GitHubActivity.astro";
import { organizationMarks } from "../data/organizationMarks";
import ContactBlock from "../components/ContactBlock.astro";
import { selectedEngineering } from "../data/recruiter";
import { profile } from "../data/profile";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="About — Vraj Patel"
  description="About Vraj Patel, a systems integration engineer and dual M.S. student at CU Boulder."
>
  <header class="about-header pb-8 sm:pb-14">
    <div data-reveal>
    <p class="eyebrow" data-scramble>Profile / behind the systems</p>
    <h1 class="mt-3 text-4xl font-semibold tracking-[-0.035em] text-slate-950 dark:text-white sm:text-5xl">
      About
    </h1>
    </div>
    <figure class="about-portrait" data-reveal><img src="/profile.jpg" alt="Vraj Patel" width="240" height="240" loading="eager" decoding="async" /><figcaption>{profile.location}</figcaption></figure>
  </header>

  <section class="border-y border-slate-200 py-10 sm:py-12 dark:border-slate-800" aria-labelledby="github-activity-heading">
    <div class="max-w-3xl">
      <p class="font-mono text-xs text-slate-500 dark:text-slate-400">Public engineering activity</p>
      <h2 id="github-activity-heading" class="mt-2 text-2xl font-semibold tracking-tight text-slate-950 dark:text-white sm:text-3xl">
        GitHub activity across personal and academic work
      </h2>
      <p class="mt-3 text-base leading-7 text-slate-600 dark:text-slate-400">
        One calendar overlays the public contribution histories of my personal
        and academic profiles. GitHub data is synced four times daily.
      </p>
    </div>
    <GitHubActivity />
  </section>

  <div class="grid gap-10 pt-10 sm:pt-14 md:grid-cols-[12rem_1fr] md:gap-16">
    <aside class="text-sm leading-6 text-slate-600 dark:text-slate-400">
      <dl class="grid grid-cols-2 gap-x-5 gap-y-5 md:block md:space-y-5">
        <div>
          <dt class="font-mono text-xs text-slate-500 dark:text-slate-400">Location</dt>
          <dd class="mt-1">{profile.location}</dd>
        </div>
        <div>
          <dt class="font-mono text-xs text-slate-500 dark:text-slate-400">Work</dt>
          <dd class="mt-1">{profile.employer.short}</dd>
        </div>
        <div class="col-span-2 md:col-span-1">
          <dt class="font-mono text-xs text-slate-500 dark:text-slate-400">Study</dt>
          <dd class="mt-1">{profile.education}</dd>
        </div>
      </dl>

      <nav aria-label="Professional links" class="mt-6 flex flex-wrap items-center gap-x-5 md:mt-8 md:flex-col md:items-start md:gap-2">
        <a
          href="https://www.linkedin.com/in/vrajmp/"
          target="_blank"
          rel="noopener noreferrer"
          data-ph-event="social_profile_clicked"
          data-ph-network="linkedin"
          class="inline-flex min-h-11 items-center underline decoration-slate-300 underline-offset-4 hover:text-blue-700 focus-visible:rounded-sm dark:decoration-slate-700 dark:hover:text-blue-400"
        >LinkedIn</a>
        {
          profile.githubProfiles.map(({ href, label, username }) => (
            <a
              href={href}
              target="_blank"
              rel="noopener noreferrer"
              data-ph-event="social_profile_clicked"
              data-ph-network="github"
              data-ph-account={username}
              class="inline-flex min-h-11 items-center underline decoration-slate-300 underline-offset-4 hover:text-blue-700 focus-visible:rounded-sm dark:decoration-slate-700 dark:hover:text-blue-400"
            >{label}</a>
          ))
        }
        <a
          href="/resume.pdf"
          target="_blank"
          rel="noopener noreferrer"
          data-ph-event="resume_clicked"
          data-ph-placement="about"
          class="inline-flex min-h-11 items-center underline decoration-slate-300 underline-offset-4 hover:text-blue-700 focus-visible:rounded-sm dark:decoration-slate-700 dark:hover:text-blue-400"
        >Resume (PDF)</a>
      </nav>
    </aside>

    <div class="min-w-0">
      <section aria-labelledby="background-heading">
        <h2 id="background-heading" class="text-2xl font-semibold tracking-tight text-slate-950 dark:text-white">
          Background
        </h2>
        <div class="mt-5 space-y-5 text-base leading-7 text-slate-600 dark:text-slate-400 sm:text-lg sm:leading-8">
          <p>
            I’m a systems integration engineer at CU Boulder’s Institute of
            Behavioral Science, where I build internal services, automation,
            and an ML-assisted ticket-intelligence platform.
          </p>
          <p>
            My parliamentary-data work grew from speech and translation evaluation
            at CU Boulder’s Studio Lab into end-to-end pipeline engineering at
            Princeton. <a class="text-link" href="/experience">See the separate appointments and contributions.</a>
          </p>
          <p>
            Through Purdue’s Data Mine of the Rockies, I worked directly with
            L3Harris senior engineers on synthetic satellite telemetry,
            cyberattack anomalies, and the research presented to space and
            cybersecurity stakeholders.
          </p>
          <p>
            I’m completing dual M.S. programs in Computer Science and Engineering
            Management at CU Boulder, where I earned a B.S. in Computer Science
            with a Business minor. Outside work, I use a personal TrueNAS and
            Docker home lab to learn by operating the systems I build.
          </p>
        </div>
      </section>

      <section class="mt-12 border-t border-slate-200 pt-9 dark:border-slate-800" aria-labelledby="current-heading">
        <h2 id="current-heading" class="text-2xl font-semibold tracking-tight text-slate-950 dark:text-white">
          Current
        </h2>
        <dl class="mt-6">
          <div class="grid gap-1 border-t border-slate-200 py-5 sm:grid-cols-[1fr_auto] sm:gap-x-8 dark:border-slate-800">
              <dt class="font-medium text-slate-950 dark:text-white">Systems Integration Engineer</dt>
              <dd class="sm:col-start-1 text-sm leading-6 text-slate-600 dark:text-slate-400">{profile.employer.parent} · {profile.employer.name}</dd>
            <dd class="sm:col-start-2 sm:row-start-1 sm:row-span-2 font-mono text-xs leading-6 text-slate-500 dark:text-slate-400">May 2025 – Present</dd>
          </div>
          <div class="grid gap-1 border-t border-slate-200 py-5 sm:grid-cols-[1fr_auto] sm:gap-x-8 dark:border-slate-800">
              <dt class="font-medium text-slate-950 dark:text-white">Dual M.S. · Computer Science + Engineering Management</dt>
              <dd class="sm:col-start-1 text-sm leading-6 text-slate-600 dark:text-slate-400">University of Colorado Boulder</dd>
            <dd class="sm:col-start-2 sm:row-start-1 sm:row-span-2 font-mono text-xs leading-6 text-slate-500 dark:text-slate-400">In progress</dd>
          </div>
          <div class="grid gap-1 border-t border-slate-200 py-5 sm:grid-cols-[1fr_auto] sm:gap-x-8 dark:border-slate-800">
              <dt class="font-medium text-slate-950 dark:text-white">Research paper in progress</dt>
              <dd class="sm:col-start-1 text-sm leading-6 text-slate-600 dark:text-slate-400">Secure GitHub collaboration for work governed by federal data-protection agreements</dd>
            <dd class="sm:col-start-2 sm:row-start-1 sm:row-span-2 font-mono text-xs leading-6 text-slate-500 dark:text-slate-400">In progress</dd>
          </div>
        </dl>
      </section>

      <section class="mt-10 border-t border-slate-200 pt-9 dark:border-slate-800" aria-labelledby="affiliations-heading">
        <h2 id="affiliations-heading" class="text-2xl font-semibold tracking-tight text-slate-950 dark:text-white">
          Research appointments and collaborations
        </h2>
        <ul class="about-affiliations mt-6 grid gap-4">
          {
            profile.affiliations
              .filter(({ discipline }) => discipline === "Research")
              .map((affiliation) => (
                <li class="flex items-center gap-4 border-t border-slate-200 py-4 dark:border-slate-800">
                  <OrganizationMarks
                    {...organizationMarks[affiliation.mark]}
                    size="compact"
                  />
                  <span class="text-sm font-medium leading-6 text-slate-800 dark:text-slate-200">
                    {affiliation.organization}
                  </span>
                </li>
              ))
          }
        </ul>
      </section>

    </div>
  </div>

  <section class="page-section" aria-labelledby="engineering-notes" data-reveal>
    <p class="eyebrow">Inside the work</p>
    <h2 id="engineering-notes" class="section-title">Selected engineering decisions</h2>
    <p class="muted-copy">A few places to look beyond the contribution count.</p>
    <ul class="engineering-links">{selectedEngineering.map(item => <li><a class="text-link" href={item.href}>{item.title}</a><p>{item.description}</p></li>)}</ul>
  </section>

  <ContactBlock />
</BaseLayout>

<style>
  .about-header { display: flex; gap: 2rem; align-items: center; justify-content: space-between; }
  .about-header h1 { font-family: var(--font-display, Georgia, serif); font-size: clamp(3.5rem, 7vw, 5.5rem); line-height: 1.05; font-weight: 400; color: var(--ink); }
  .about-portrait { flex-shrink: 0; width: clamp(6rem, 17vw, 12rem); padding: .5rem; border: 1px solid var(--line); border-radius: 8px; background: var(--paper-2, var(--surface)); transform: rotate(2deg); }
  .about-portrait img { width: 100%; height: auto; aspect-ratio: 1; object-fit: cover; border-radius: 4px; }
  .about-portrait figcaption { margin-top: .5rem; text-align: center; font-family: var(--font-mono); color: var(--muted); font-size: .55rem; line-height: 1.5; }
  .about-affiliations { grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr)); }
  .about-affiliations > li { min-width: 0; flex-wrap: wrap; }
  .about-affiliations > li > span { color: var(--copy); }
  @media (max-width: 399px) { .about-header { gap: .75rem; } .about-header .eyebrow { font-size: .6rem; } .about-portrait { width: 5.5rem; } }
</style>
