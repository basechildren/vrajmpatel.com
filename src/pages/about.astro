---
import { Image } from "astro:assets";
import portrait from "../assets/profile.jpg";
import OrganizationMarks from "../components/OrganizationMarks.astro";
import GitHubActivity from "../components/GitHubActivity.astro";
import { organizationMarks } from "../data/organizationMarks";
import { selectedEngineering } from "../data/recruiter";
import { profile } from "../data/profile";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="About — Vraj Patel"
  description="About Vraj Patel, a systems integration engineer and dual M.S. student at CU Boulder."
  contact
>
  <header class="page-header about-header">
    <div>
    <p class="eyebrow">Profile</p>
    <h1 class="page-title">
      About
    </h1>
    </div>
    <figure class="about-portrait"><Image src={portrait} alt="Vraj Patel" width={384} height={384} widths={[192, 384]} sizes="(min-width: 640px) 144px, 96px" format="webp" loading="eager" decoding="async" /></figure>
  </header>



  <div class="about-details grid gap-10 md:grid-cols-[12rem_1fr] md:gap-16">
    <aside class="text-sm leading-6 text-slate-600 dark:text-slate-400">
      <dl class="grid grid-cols-2 gap-x-5 gap-y-5 md:block md:space-y-5">
        <div>
          <dt class="font-mono text-xs text-slate-500 dark:text-slate-400">Location</dt>
          <dd class="mt-1">{profile.location}</dd>
        </div>
        <div>
          <dt class="font-mono text-xs text-slate-500 dark:text-slate-400">Work</dt>
          <dd class="mt-1">{profile.employer.short}</dd>
        </div>
        <div class="col-span-2 md:col-span-1">
          <dt class="font-mono text-xs text-slate-500 dark:text-slate-400">Study</dt>
          <dd class="mt-1">{profile.education}</dd>
        </div>
      </dl>

      <nav aria-label="Professional links" class="mt-6 flex flex-wrap items-center gap-x-5 md:mt-8 md:flex-col md:items-start md:gap-2">
        <a
          href="https://www.linkedin.com/in/vrajmp/"
          target="_blank"
          rel="noopener noreferrer"
          data-ph-event="social_profile_clicked"
          data-ph-network="linkedin"
          class="inline-flex min-h-11 items-center underline decoration-slate-300 underline-offset-4 hover:text-blue-700 focus-visible:rounded-sm dark:decoration-slate-700 dark:hover:text-blue-400"
        >LinkedIn</a>
        {
          profile.githubProfiles.map(({ href, label, username }) => (
            <a
              href={href}
              target="_blank"
              rel="noopener noreferrer"
              data-ph-event="social_profile_clicked"
              data-ph-network="github"
              data-ph-account={username}
              class="inline-flex min-h-11 items-center underline decoration-slate-300 underline-offset-4 hover:text-blue-700 focus-visible:rounded-sm dark:decoration-slate-700 dark:hover:text-blue-400"
            >{label}</a>
          ))
        }
        <a
          href="/resume.pdf"
          target="_blank"
          rel="noopener noreferrer"
          data-ph-event="resume_clicked"
          data-ph-placement="about"
          class="inline-flex min-h-11 items-center underline decoration-slate-300 underline-offset-4 hover:text-blue-700 focus-visible:rounded-sm dark:decoration-slate-700 dark:hover:text-blue-400"
        >Software resume · PDF</a>
      </nav>
    </aside>

    <div class="about-background min-w-0">
      <section aria-labelledby="background-heading">
        <h2 id="background-heading" class="text-2xl font-semibold tracking-tight text-slate-950 dark:text-white">
          Background
        </h2>
        <div class="mt-5 space-y-5 text-base leading-7 text-slate-600 dark:text-slate-400 sm:text-lg sm:leading-8">
          <p>
            I build internal services, automation, and an ML-assisted ticket-review
            platform at CU Boulder’s Institute of Behavioral Science.
          </p>
          <p>
            At Studio Lab, I evaluated speech and translation tools. At IBS, I built
            a production speech pipeline. At Princeton, I built pipelines for
            parliamentary records. <a class="about-inline-link" href="/experience/">See my experience.</a>
          </p>
          <p>
            With Purdue’s Data Mine of the Rockies and L3Harris, I studied
            cyberattack detection in simulated satellite telemetry.
          </p>
          <p>
            I’m pursuing an M.S. in Computer Science and M.E. in Engineering Management
            at CU Boulder (expected May 2028), where I earned a B.S. in Computer Science
            with a Business minor. I also run a home lab with Docker, TrueNAS, and
            Terraform on Oracle Cloud.
          </p>
        </div>
      </section>

      <section class="mt-12 border-t border-slate-200 pt-9 dark:border-slate-800" aria-labelledby="current-heading">
        <h2 id="current-heading" class="text-2xl font-semibold tracking-tight text-slate-950 dark:text-white">Current research</h2>
        <p class="mt-4 text-base leading-7 text-slate-600 dark:text-slate-400">A paper in progress on secure GitHub collaboration for research governed by federal data-protection agreements.</p>
      </section>

      <section class="mt-10 border-t border-slate-200 pt-9 dark:border-slate-800" aria-labelledby="affiliations-heading">
        <h2 id="affiliations-heading" class="text-2xl font-semibold tracking-tight text-slate-950 dark:text-white">
          Research affiliations
        </h2>
        <ul class="about-affiliations mt-6 grid gap-4">
          {
            profile.affiliations
              .filter(({ discipline }) => discipline === "Research")
              .map((affiliation) => (
                <li class="flex items-center gap-4 border-t border-slate-200 py-4 dark:border-slate-800">
                  <OrganizationMarks
                    {...organizationMarks[affiliation.mark]}
                    size="compact"
                  />
                  <span class="text-sm font-medium leading-6 text-slate-800 dark:text-slate-200">
                    {affiliation.organization}
                  </span>
                </li>
              ))
          }
        </ul>
      </section>

    </div>
  </div>

  <section class="page-section border-y border-slate-200 py-10 sm:py-12 dark:border-slate-800" aria-labelledby="github-activity-heading">
    <div class="max-w-3xl">
      <h2 id="github-activity-heading" class="text-2xl font-semibold tracking-tight text-slate-950 dark:text-white sm:text-3xl">
        Public GitHub activity
      </h2>
      <p class="mt-3 text-base leading-7 text-slate-600 dark:text-slate-400">
        Contributions from my personal and academic accounts.
      </p>
    </div>
    <GitHubActivity />
  </section>

  <section class="page-section" aria-labelledby="engineering-notes" data-reveal>
    <p class="eyebrow">Inside the work</p>
    <h2 id="engineering-notes" class="section-title">Selected engineering decisions</h2>
    <ul class="engineering-links">{selectedEngineering.map(item => <li><a class="text-link" href={item.href}>{item.title}</a><p>{item.description}</p></li>)}</ul>
  </section>

</BaseLayout>

<style>
  .about-header { display: flex; max-width: none; gap: 2rem; align-items: center; justify-content: space-between; }
  .about-portrait { flex-shrink: 0; width: clamp(6rem, 12vw, 9rem); padding: .5rem; border: 1px solid var(--line); border-radius: 8px; background: var(--paper-2, var(--surface)); }
  .about-portrait img { width: 100%; height: auto; aspect-ratio: 1; object-fit: cover; border-radius: 4px; }
  .about-inline-link { color: var(--ink); text-decoration: underline; text-decoration-color: var(--line); text-underline-offset: 4px; }
  .about-inline-link:hover { color: var(--accent); text-decoration-color: currentColor; }
  .about-affiliations { grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr)); }
  .about-affiliations > li { min-width: 0; flex-wrap: wrap; }
  .about-affiliations > li > span { color: var(--copy); }
  @media (max-width: 767px) { .about-background { grid-row: 1; } }
  @media (max-width: 399px) { .about-header { gap: .75rem; } .about-header .eyebrow { font-size: .6rem; } .about-portrait { width: 5.5rem; } }
</style>
