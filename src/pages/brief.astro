---
import { getCollection } from "astro:content";
import { profile } from "../data/profile";
import { isPublicProject, isCaseStudy, sortProjects } from "../lib/projects";
import BaseLayout from "../layouts/BaseLayout.astro";
const projects = (await getCollection("projects")).filter(isPublicProject).filter(isCaseStudy).sort(sortProjects);
---
<BaseLayout title="Recruiter Brief — Vraj Patel" description="Vraj Patel: role fit, selected contributions, education, and professional contact in one concise brief.">
  <article class="recruiter-brief">
    <header>
      <p class="eyebrow">Recruiter brief</p>
      <h1 class="page-title">{profile.name}</h1>
      <p class="brief-position">{profile.role} · CU Boulder</p>
      <p class="muted-copy">Python, SQL, backend systems, and applied ML. I build internal software and data workflows with clear state, review, and recovery.</p>
      <nav class="action-row print:hidden" aria-label="Recruiter resources">
        <a href="/resume.pdf" class="button-primary" target="_blank" rel="noopener noreferrer" data-ph-event="resume_clicked" data-ph-placement="recruiter_brief">Resume (PDF)</a>
        <a href="/resume" class="text-link">All resume versions</a>
        <button type="button" class="text-link" data-print-brief hidden>Print / save brief</button>
        <a href="#contact" class="text-link">Contact</a>
      </nav>
    </header>
    <dl class="brief-facts">
      <div><dt class="eyebrow">Strongest fit</dt><dd>Backend / Platform · Data Engineering · Applied ML</dd></div>
      <div><dt class="eyebrow">Location</dt><dd>{profile.location}</dd></div>
    </dl>
    <section aria-labelledby="brief-projects">
      <h2 id="brief-projects" class="section-title">Selected contributions</h2>
      <ol class="brief-projects">
        {projects.map((entry, i) => <li>
          <span class="eyebrow" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
          <div><h3><a class="text-link" href={`/projects/${entry.id}`} data-ph-event="project_opened" data-ph-project={entry.id} data-ph-placement="recruiter_brief">{entry.data.title}</a></h3>
          <p>{entry.data.contribution}</p><p class="brief-evidence">{entry.data.proof?.[entry.id === "full-stack-biometric-marathon" ? 2 : 0]?.value} — {entry.data.proof?.[entry.id === "full-stack-biometric-marathon" ? 2 : 0]?.label}</p></div>
        </li>)}
      </ol>
    </section>
    <section class="brief-education" aria-labelledby="brief-education">
      <h2 id="brief-education" class="section-title">Education</h2>
      <p>M.S. Computer Science + M.E. Engineering Management (concurrent dual degree) · CU Boulder · expected May 2028.</p>
      <p>B.S. in Computer Science, Business minor · CU Boulder.</p>
    </section>
    <section id="contact" class="brief-contact" aria-labelledby="contact-heading">
      <h2 id="contact-heading" class="section-title">Contact</h2>
      <a class="text-link" href="https://www.linkedin.com/in/vrajmp/" target="_blank" rel="noopener noreferrer" data-ph-event="social_profile_clicked" data-ph-network="linkedin" data-ph-placement="recruiter_brief">Message me on LinkedIn</a>
      <p class="print-address">linkedin.com/in/vrajmp/ · vrajmpatel.com</p>
    </section>
  </article>
</BaseLayout>
<script>
  const button = document.querySelector<HTMLButtonElement>("[data-print-brief]");
  if (button) { button.hidden = false; button.addEventListener("click", () => window.print()); }
</script>
