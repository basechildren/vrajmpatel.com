---
import { getCollection, render } from "astro:content";
import ExperienceItem from "../components/ExperienceItem.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const entries = (await getCollection("experience")).sort(
  (a, b) => a.data.order - b.data.order,
);
const experience = await Promise.all(
  entries.map(async (entry) => ({ entry, Content: (await render(entry)).Content })),
);
---

<BaseLayout
  title="Experience — Vraj Patel"
  description="Backend, data, and machine-learning experience across CU Boulder, Princeton, Purdue, and L3Harris."
>
  <header class="max-w-3xl pb-10 sm:pb-14">
    <p class="font-mono text-xs text-slate-500 dark:text-slate-500">Career</p>
    <h1 class="mt-3 text-4xl font-semibold tracking-[-0.035em] text-slate-950 dark:text-white sm:text-5xl">
      Experience
    </h1>
    <p class="mt-5 text-lg leading-8 text-slate-600 dark:text-slate-400">
      Backend, data, and ML work across CU Boulder, Princeton, Purdue, and
      L3Harris.
    </p>
  </header>

  <section aria-label="Professional experience">
    {
      experience.map(({ entry, Content }) => (
        <ExperienceItem entry={entry} variant="detailed">
          <Content />
        </ExperienceItem>
      ))
    }
  </section>
</BaseLayout>
