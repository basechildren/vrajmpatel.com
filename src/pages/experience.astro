---
import { getCollection, render } from "astro:content";
import ContactBlock from "../components/ContactBlock.astro";
import ExperienceItem from "../components/ExperienceItem.astro";
import { isPublicExperience } from "../lib/projects";
import BaseLayout from "../layouts/BaseLayout.astro";

const entries = (await getCollection("experience")).filter(isPublicExperience).sort(
  (a, b) => a.data.order - b.data.order,
);
const experience = await Promise.all(
  entries.map(async (entry) => ({ entry, Content: (await render(entry)).Content })),
);
---

<BaseLayout
  title="Experience — Vraj Patel"
  description="Systems integration, backend, data, and machine-learning experience across CU Boulder, Purdue, and L3Harris."
>
  <header class="experience-header max-w-3xl pb-10 sm:pb-14" data-reveal>
    <p class="eyebrow" data-scramble>Career / engineering log</p>
    <h1 class="mt-3 text-4xl font-semibold tracking-[-0.035em] text-slate-950 dark:text-white sm:text-5xl">
      Experience
    </h1>
    <p class="mt-5 text-lg leading-8 text-slate-600 dark:text-slate-400">
      Systems integration and data engineering at CU Boulder and Princeton,
      alongside satellite cybersecurity research through Purdue and L3Harris.
    </p>
  </header>

  <section class="experience-timeline" aria-label="Professional experience">
    {
      experience.map(({ entry, Content }) => (
        <ExperienceItem entry={entry} variant="detailed">
          <Content />
        </ExperienceItem>
      ))
    }
  </section>
  <ContactBlock />
</BaseLayout>

<style>
  .experience-header h1 { font-family: var(--font-display, Georgia, serif); font-size: clamp(3.5rem, 7vw, 5.5rem); line-height: 1.05; font-weight: 400; color: var(--ink); }
  .experience-timeline { max-width: 64rem; }
</style>
