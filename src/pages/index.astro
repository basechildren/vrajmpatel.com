---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import ExperienceItem from "../components/ExperienceItem.astro";
import OrganizationMarks from "../components/OrganizationMarks.astro";
import ProjectCard from "../components/ProjectCard.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const featured = (await getCollection("projects", ({ data }) => data.featured))
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99))
  .slice(0, 3);

const recentExperience = (await getCollection("experience"))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);
---

<BaseLayout
  title="Vraj Patel — Backend and ML Systems Engineer"
  description="Backend and ML systems engineer building data pipelines, APIs, and applied machine-learning systems at CU Boulder and Princeton."
  schemaType="Person"
>
  <section
    class="grid items-start gap-10 border-b border-slate-200 pb-16 sm:grid-cols-[1fr_11rem] sm:gap-14 sm:pb-20 dark:border-slate-800"
    aria-labelledby="intro-heading"
  >
    <div>
      <p class="font-mono text-xs text-slate-500 dark:text-slate-500">
        Boulder, Colorado
      </p>
      <h1
        id="intro-heading"
        class="mt-4 text-4xl font-semibold tracking-[-0.04em] text-slate-950 dark:text-white sm:text-6xl"
      >
        Vraj Patel
      </h1>
      <p
        class="mt-5 max-w-2xl text-2xl font-medium leading-tight tracking-[-0.025em] text-slate-800 dark:text-slate-200 sm:text-3xl"
      >
        Backend and ML systems engineer.
      </p>
      <p class="mt-6 max-w-2xl text-base leading-8 text-slate-600 dark:text-slate-400 sm:text-lg">
        I build data pipelines, APIs, and applied ML systems at CU Boulder and
        Princeton. I’m currently pursuing an M.S. in Computer Science.
      </p>
      <div class="mt-8 flex flex-wrap items-center gap-x-5 gap-y-3 text-sm font-medium">
        <a
          href="#selected-work"
          class="inline-flex min-h-11 items-center rounded-md bg-slate-950 px-4 text-white transition-colors hover:bg-blue-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 focus-visible:ring-offset-2 dark:bg-white dark:text-slate-950 dark:hover:bg-blue-200 dark:focus-visible:ring-offset-slate-950"
        >
          Selected work
        </a>
        <a
          href="/resume.pdf"
          target="_blank"
          rel="noopener noreferrer"
          data-ph-event="resume_clicked"
          data-ph-placement="hero"
          class="underline decoration-slate-300 underline-offset-4 hover:text-blue-700 focus-visible:rounded-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 dark:decoration-slate-700 dark:hover:text-blue-400"
        >
          Resume
        </a>
        <a
          href="mailto:vrajmp999@gmail.com"
          data-ph-event="contact_clicked"
          data-ph-placement="hero"
          class="underline decoration-slate-300 underline-offset-4 hover:text-blue-700 focus-visible:rounded-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 dark:decoration-slate-700 dark:hover:text-blue-400"
        >
          Email
        </a>
      </div>

      <ul
        aria-label="Current affiliations"
        class="mt-10 flex flex-wrap gap-x-8 gap-y-4 border-t border-slate-200 pt-6 dark:border-slate-800"
      >
        <li class="flex items-center gap-3">
          <OrganizationMarks logo="/logos/cu-standalone.png.avif" size="compact" />
          <div>
            <p class="font-mono text-[0.65rem] text-slate-500 dark:text-slate-500">Engineering</p>
            <p class="mt-0.5 text-sm font-medium text-slate-800 dark:text-slate-200">CU Boulder</p>
          </div>
        </li>
        <li class="flex items-center gap-3">
          <OrganizationMarks logo="/logos/princeton.png" size="compact" />
          <div>
            <p class="font-mono text-[0.65rem] text-slate-500 dark:text-slate-500">Research</p>
            <p class="mt-0.5 text-sm font-medium text-slate-800 dark:text-slate-200">Princeton Studio Lab</p>
          </div>
        </li>
      </ul>
    </div>

    <Image
      src="/profile.jpg"
      alt="Portrait of Vraj Patel"
      width={176}
      height={208}
      class="h-40 w-32 rounded-lg object-cover object-center sm:h-52 sm:w-44"
      fetchpriority="high"
      loading="eager"
    />
  </section>

  <section id="selected-work" class="scroll-mt-6 pt-16 sm:pt-20" aria-labelledby="work-heading">
    <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="font-mono text-xs text-slate-500 dark:text-slate-500">Projects</p>
        <h2 id="work-heading" class="mt-2 text-2xl font-semibold tracking-tight text-slate-950 dark:text-white sm:text-3xl">
          Selected work
        </h2>
        <p class="mt-3 text-base text-slate-600 dark:text-slate-400">
          Applied ML, backend, and data-engineering projects.
        </p>
      </div>
      <a
        href="/projects"
        class="text-sm font-medium underline decoration-slate-300 underline-offset-4 hover:text-blue-700 focus-visible:rounded-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 dark:decoration-slate-700 dark:hover:text-blue-400"
      >
        All projects
      </a>
    </div>

    <div class="mt-8">
      {
        featured.map((entry) => (
          <ProjectCard entry={entry} headingLevel="h3" showDomain={true} />
        ))
      }
    </div>
  </section>

  <section class="pt-16 sm:pt-20" aria-labelledby="experience-heading">
    <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="font-mono text-xs text-slate-500 dark:text-slate-500">Career</p>
        <h2 id="experience-heading" class="mt-2 text-2xl font-semibold tracking-tight text-slate-950 dark:text-white sm:text-3xl">
          Experience
        </h2>
      </div>
      <a
        href="/experience"
        class="text-sm font-medium underline decoration-slate-300 underline-offset-4 hover:text-blue-700 focus-visible:rounded-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 dark:decoration-slate-700 dark:hover:text-blue-400"
      >
        Full experience
      </a>
    </div>

    <div class="mt-8">
      {
        recentExperience.map((entry) => (
          <ExperienceItem entry={entry} variant="compact" />
        ))
      }
    </div>
  </section>

  <section class="mt-16 border-t border-slate-200 pt-10 sm:mt-20 sm:grid sm:grid-cols-[1fr_auto] sm:items-end sm:gap-10 dark:border-slate-800" aria-labelledby="contact-heading">
    <div>
      <p class="font-mono text-xs text-slate-500 dark:text-slate-500">Contact</p>
      <h2 id="contact-heading" class="mt-2 text-2xl font-semibold tracking-tight text-slate-950 dark:text-white sm:text-3xl">
        Open to backend and ML engineering roles.
      </h2>
      <p class="mt-3 max-w-2xl text-base leading-7 text-slate-600 dark:text-slate-400">
        For roles or research collaborations, send me an email.
      </p>
    </div>
    <a
      href="mailto:vrajmp999@gmail.com"
      data-ph-event="contact_clicked"
      data-ph-placement="contact_section"
      class="mt-6 inline-flex min-h-11 items-center rounded-md border border-slate-300 px-4 text-sm font-medium text-slate-800 transition-colors hover:border-slate-500 hover:text-slate-950 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 sm:mt-0 dark:border-slate-700 dark:text-slate-300 dark:hover:border-slate-500 dark:hover:text-white"
    >
      Email Vraj
    </a>
  </section>
</BaseLayout>
