---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import ExperienceItem from "../components/ExperienceItem.astro";
import OrganizationMarks from "../components/OrganizationMarks.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { organizationMarks } from "../data/organizationMarks";
import { profile } from "../data/profile";
import { isCaseStudy, isPublicProject, sortProjects } from "../lib/projects";
import BaseLayout from "../layouts/BaseLayout.astro";

const featured = (await getCollection("projects", ({ data }) => data.featured))
  .filter(isPublicProject)
  .filter(isCaseStudy)
  .sort(sortProjects)
  .slice(0, 3);

const recentExperience = (await getCollection("experience"))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);
---

<BaseLayout
  title="Vraj Patel — Systems Integration Engineer"
  description="Systems integration engineer building reliable backend services, data pipelines, and applied machine-learning systems at CU Boulder."
  schemaType="Person"
>
  <section
    class="grid items-start gap-10 border-b border-slate-200 pb-16 sm:grid-cols-[1fr_11rem] sm:gap-14 sm:pb-20 dark:border-slate-800"
    aria-labelledby="intro-heading"
  >
    <div>
      <p class="font-mono text-xs text-slate-500 dark:text-slate-400">
        {profile.location}
      </p>
      <h1
        id="intro-heading"
        class="mt-4 text-4xl font-semibold tracking-[-0.04em] text-slate-950 dark:text-white sm:text-6xl"
      >
        {profile.name}
      </h1>
      <p
        class="mt-5 max-w-2xl text-2xl font-medium leading-tight tracking-[-0.025em] text-slate-800 dark:text-slate-200 sm:text-3xl"
      >
        Systems integration engineer building reliable services and data systems.
      </p>
      <p class="mt-6 max-w-2xl text-base leading-8 text-slate-600 dark:text-slate-400 sm:text-lg">
        At CU Boulder’s Institute of Behavioral Science, I build internal services,
        automation, and applied ML tools for day-to-day operations. My research
        spans public-interest data, satellite telemetry, and cybersecurity.
      </p>
      <div class="mt-8 flex flex-wrap items-center gap-x-5 gap-y-3 text-sm font-medium">
        <a
          href="#selected-work"
          class="inline-flex min-h-11 items-center rounded-md bg-slate-950 px-4 text-white transition-colors hover:bg-blue-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 focus-visible:ring-offset-2 dark:bg-white dark:text-slate-950 dark:hover:bg-blue-200 dark:focus-visible:ring-offset-slate-950"
        >
          Selected work
        </a>
        <a
          href="/resume.pdf"
          target="_blank"
          rel="noopener noreferrer"
          data-ph-event="resume_clicked"
          data-ph-placement="hero"
          class="underline decoration-slate-300 underline-offset-4 hover:text-blue-700 focus-visible:rounded-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 dark:decoration-slate-700 dark:hover:text-blue-400"
        >
          Resume
        </a>
        <a
          href="https://www.linkedin.com/in/vrajmp/"
          target="_blank"
          rel="noopener noreferrer"
          data-ph-event="social_profile_clicked"
          data-ph-network="linkedin"
          data-ph-placement="hero"
          class="underline decoration-slate-300 underline-offset-4 hover:text-blue-700 focus-visible:rounded-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 dark:decoration-slate-700 dark:hover:text-blue-400"
        >
          LinkedIn
        </a>
      </div>

      <ul
        aria-label="Professional affiliations"
        class="mt-10 grid gap-x-8 gap-y-4 border-t border-slate-200 pt-6 sm:grid-cols-2"
      >
        {
          profile.affiliations.map((affiliation) => (
            <li class="flex items-center gap-4">
              <OrganizationMarks
                {...organizationMarks[affiliation.mark]}
                size="compact"
              />
              <div class="min-w-0">
                <p class="font-mono text-[0.65rem] text-slate-500 dark:text-slate-400">
                  {affiliation.discipline}
                </p>
                <p class="mt-0.5 text-sm font-medium leading-5 text-slate-800 dark:text-slate-200">
                  {affiliation.organization}
                </p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>

    <Image
      src="/profile.jpg"
      alt="Portrait of Vraj Patel"
      width={176}
      height={208}
      class="h-40 w-32 rounded-lg object-cover object-center sm:h-52 sm:w-44"
      fetchpriority="high"
      loading="eager"
    />
  </section>

  <section id="selected-work" class="scroll-mt-6 pt-16 sm:pt-20" aria-labelledby="work-heading">
    <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="font-mono text-xs text-slate-500 dark:text-slate-400">Projects</p>
        <h2 id="work-heading" class="mt-2 text-2xl font-semibold tracking-tight text-slate-950 dark:text-white sm:text-3xl">
          Selected work
        </h2>
        <p class="mt-3 text-base text-slate-600 dark:text-slate-400">
          Applied ML, backend systems, and data-engineering projects.
        </p>
      </div>
      <a
        href="/projects"
        class="text-sm font-medium underline decoration-slate-300 underline-offset-4 hover:text-blue-700 focus-visible:rounded-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 dark:decoration-slate-700 dark:hover:text-blue-400"
      >
        All projects
      </a>
    </div>

    <div class="mt-8">
      {
        featured.map((entry) => (
          <ProjectCard entry={entry} headingLevel="h3" showDomain={true} />
        ))
      }
    </div>
  </section>

  <section class="pt-16 sm:pt-20" aria-labelledby="experience-heading">
    <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="font-mono text-xs text-slate-500 dark:text-slate-400">Career</p>
        <h2 id="experience-heading" class="mt-2 text-2xl font-semibold tracking-tight text-slate-950 dark:text-white sm:text-3xl">
          Experience
        </h2>
      </div>
      <a
        href="/experience"
        class="text-sm font-medium underline decoration-slate-300 underline-offset-4 hover:text-blue-700 focus-visible:rounded-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 dark:decoration-slate-700 dark:hover:text-blue-400"
      >
        Full experience
      </a>
    </div>

    <div class="mt-8">
      {
        recentExperience.map((entry) => (
          <ExperienceItem entry={entry} variant="compact" />
        ))
      }
    </div>
  </section>

</BaseLayout>
