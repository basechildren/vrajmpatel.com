---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import ExperienceItem from "../components/ExperienceItem.astro";
import ProofGrid from "../components/ProofGrid.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { profile } from "../data/profile";
import ContactBlock from "../components/ContactBlock.astro";
import SystemFlow from "../components/SystemFlow.astro";
import { proofPoints } from "../data/recruiter";
import {
  isCaseStudy,
  isPublicExperience,
  isPublicProject,
  sortProjects,
} from "../lib/projects";
import BaseLayout from "../layouts/BaseLayout.astro";

const featured = (await getCollection("projects", ({ data }) => data.featured))
  .filter(isPublicProject)
  .filter(isCaseStudy)
  .sort(sortProjects)
  .slice(0, 3);

const recentExperience = (await getCollection("experience"))
  .filter(isPublicExperience)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 4);
---
<BaseLayout title="Vraj Patel — Software Engineer | Data and ML Systems" description={profile.description} schemaType="Person">
  <section class="home-intro" aria-labelledby="intro-heading">
    <div class="home-intro-copy">
      <div class="home-identity">
        <Image src="/profile.jpg" alt="Portrait of Vraj Patel" width={88} height={88} class="home-portrait" loading="eager" />
        <p class="eyebrow"><span class="home-role" data-scramble>{profile.role}</span><br />{profile.location}</p>
      </div>
      <h1 id="intro-heading" class="home-name" data-intro>{profile.name}</h1>
      <p class="home-statement" data-split>I build reliable software, <em class="display-accent">data pipelines,</em> and applied ML systems.</p>
      <p class="muted-copy">At CU Boulder’s Institute of Behavioral Science. I connect Python, TypeScript, and SQL with research, operational workflows, and the people who use the results.</p>
      <nav class="action-row" aria-label="Explore my work">
        <a href="#selected-work" class="button-primary">Explore the work <span aria-hidden="true" class="ml-3">↗</span></a>
        <a href="/brief" class="text-link" data-ph-event="recruiter_brief_opened" data-ph-placement="hero">Recruiter brief</a>
        <a href="#contact" class="text-link">Contact</a>
      </nav>
    </div>
    <div class="home-system"><SystemFlow placement="hero" /></div>
  </section>

  <section id="selected-work" class="page-section" aria-labelledby="work-heading">
    <div class="section-heading" data-reveal>
      <div><p class="eyebrow" data-scramble>01 / Selected work</p><h2 id="work-heading" class="section-title">Three systems. Different problems.</h2></div>
      <a href="/projects" class="text-link">All case studies</a>
    </div>
    <div class="work-bento">{featured.map(entry => <ProjectCard entry={entry} headingLevel="h3" variant="feature" />)}</div>
  </section>
  <div class="home-system-after-work"><SystemFlow placement="after-work" /></div>

  <section class="page-section" aria-labelledby="proof-heading">
    <div data-reveal><p class="eyebrow">02 / Evidence at a glance</p><h2 id="proof-heading" class="section-title">Results with context.</h2></div>
    <ProofGrid items={proofPoints} class="mt-6" />
  </section>

  <section class="page-section" aria-labelledby="experience-heading">
    <div class="section-heading" data-reveal>
      <div><p class="eyebrow">03 / Career</p><h2 id="experience-heading" class="section-title">Engineering and research.</h2></div>
      <a href="/experience" class="text-link">Full experience</a>
    </div>
    <div class="mt-6">{recentExperience.map(entry => <ExperienceItem entry={entry} variant="compact" />)}</div>
  </section>
  <ContactBlock />
</BaseLayout>
