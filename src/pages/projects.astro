---
import { getCollection } from "astro:content";
import ProjectCard from "../components/ProjectCard.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const projects = (await getCollection("projects")).sort((a, b) => {
  const featuredOrder = Number(Boolean(b.data.featured)) - Number(Boolean(a.data.featured));
  return featuredOrder || (a.data.order ?? 99) - (b.data.order ?? 99);
});
---

<BaseLayout
  title="Projects — Vraj Patel"
  description="Applied machine-learning, backend, infrastructure, and research projects by Vraj Patel."
>
  <header class="max-w-3xl pb-10 sm:pb-14">
    <p class="font-mono text-xs text-slate-500 dark:text-slate-500">Work</p>
    <h1 class="mt-3 text-4xl font-semibold tracking-[-0.035em] text-slate-950 dark:text-white sm:text-5xl">
      Projects
    </h1>
    <p class="mt-5 text-lg leading-8 text-slate-600 dark:text-slate-400">
      Selected work across applied ML, backend systems, and data engineering.
      Each project page covers the contribution, constraints, and result.
    </p>
  </header>

  <section aria-label="Project list">
    {
      projects.map((entry) => (
        <ProjectCard entry={entry} headingLevel="h2" showDomain={true} />
      ))
    }
  </section>
</BaseLayout>
