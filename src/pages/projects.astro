---
import { getCollection } from "astro:content";
import ProjectCard from "../components/ProjectCard.astro";
import { isCaseStudy, isPublicProject, sortProjects } from "../lib/projects";
import BaseLayout from "../layouts/BaseLayout.astro";

const publicProjects = (await getCollection("projects")).filter(isPublicProject);
const projects = publicProjects.filter(isCaseStudy).sort(sortProjects);
const notes = publicProjects.filter((entry) => !isCaseStudy(entry)).sort(sortProjects);
---

<BaseLayout
  title="Projects — Vraj Patel"
  description="A focused selection of backend, machine-learning, and data-engineering work by Vraj Patel."
  contact
>
  <header class="page-header">
    <p class="eyebrow">Work · {projects.length} case studies</p>
    <h1 class="page-title">
      Projects
    </h1>
    <p class="page-lede">
      What I built, the decisions behind it, and the results.
    </p>
  </header>

  <section class="work-grid" aria-label="Project list">
    {
      projects.map((entry) => (
        <ProjectCard entry={entry} headingLevel="h2" showDomain={true} variant="feature" />
      ))
    }
  </section>

  {
    notes.length > 0 && (
      <section class="mt-12 border-t border-slate-200 pt-9 dark:border-slate-800" aria-labelledby="systems-practice-heading">
        <p class="font-mono text-xs text-slate-500 dark:text-slate-400">Systems practice</p>
        <h2 id="systems-practice-heading" class="mt-2 text-2xl font-semibold tracking-tight text-slate-950 dark:text-white">
          Operating what I build
        </h2>
        <p class="mt-3 max-w-2xl text-base leading-7 text-slate-600 dark:text-slate-400">
          Infrastructure I run and maintain.
        </p>
        <div class="mt-6">
          {notes.map((entry) => <ProjectCard entry={entry} headingLevel="h3" showDomain={true} />)}
        </div>
      </section>
    )
  }
</BaseLayout>
