---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<BaseLayout
  title={`${entry.data.title} — Vraj Patel`}
  description={entry.data.summary}
  ogImage={`/og/${entry.id}.png`}
  ogImageAlt={`Project preview for ${entry.data.title}`}
  schemaType="WebPage"
  robots={entry.data.visibility === "archived" ? "noindex, follow" : "index, follow"}
>
  <article class="mx-auto max-w-3xl">
    <a
      href="/projects"
      class="text-sm underline decoration-slate-300 underline-offset-4 hover:text-blue-700 focus-visible:rounded-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 dark:decoration-slate-700 dark:hover:text-blue-400"
    >
      All projects
    </a>

    <header class="mt-10 border-b border-slate-200 pb-10 dark:border-slate-800">
      <p class="font-mono text-xs text-slate-500 dark:text-slate-400">
        {entry.data.domain}
      </p>
      <h1 class="mt-3 text-4xl font-semibold tracking-[-0.035em] text-slate-950 dark:text-white sm:text-5xl">
        {entry.data.title}
      </h1>
      {
        entry.data.summary && (
          <p class="mt-6 text-lg leading-8 text-slate-600 dark:text-slate-400">
            {entry.data.summary}
          </p>
        )
      }

      <div class="mt-7 flex flex-wrap gap-x-5 gap-y-3 text-sm font-medium">
        {
          entry.data.privateRepo ? (
            <span class="text-slate-500 dark:text-slate-400">Private project</span>
          ) : entry.data.github && (
            <a
              href={entry.data.github}
              target="_blank"
              rel="noopener noreferrer"
              data-ph-event="outbound_link_clicked"
              data-ph-resource="github"
              data-ph-project={entry.id}
              class="underline decoration-slate-300 underline-offset-4 hover:text-blue-700 focus-visible:rounded-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 dark:decoration-slate-700 dark:hover:text-blue-400"
            >
              Source
            </a>
          )
        }
        {
          entry.data.paper && (
            <a
              href={entry.data.paper}
              target="_blank"
              rel="noopener noreferrer"
              data-ph-event="outbound_link_clicked"
              data-ph-resource={entry.data.paperResource ?? "paper"}
              data-ph-project={entry.id}
              class="underline decoration-slate-300 underline-offset-4 hover:text-blue-700 focus-visible:rounded-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 dark:decoration-slate-700 dark:hover:text-blue-400"
            >
              {entry.data.paperLabel ?? "Paper"}
            </a>
          )
        }
        {
          entry.data.link && (
            <a
              href={entry.data.link}
              target="_blank"
              rel="noopener noreferrer"
              data-ph-event="outbound_link_clicked"
              data-ph-resource="project_site"
              data-ph-project={entry.id}
              class="underline decoration-slate-300 underline-offset-4 hover:text-blue-700 focus-visible:rounded-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 dark:decoration-slate-700 dark:hover:text-blue-400"
            >
              Live site
            </a>
          )
        }
      </div>
    </header>

    <div class="py-10 text-base leading-8 text-slate-600 [&_a]:underline [&_a]:decoration-slate-300 [&_a]:underline-offset-4 [&_a]:hover:text-blue-700 [&_p+p]:mt-5 [&_strong]:font-semibold [&_strong]:text-slate-900 dark:text-slate-400 dark:[&_a]:decoration-slate-700 dark:[&_a]:hover:text-blue-400 dark:[&_strong]:text-slate-200 sm:text-lg">
      <Content />
    </div>

    {
      entry.data.tech && entry.data.tech.length > 0 && (
        <section class="border-t border-slate-200 pt-8 dark:border-slate-800" aria-labelledby="technologies-heading">
          <h2 id="technologies-heading" class="text-lg font-semibold text-slate-950 dark:text-white">
            Technologies
          </h2>
          <p class="mt-3 font-mono text-xs leading-6 text-slate-500 dark:text-slate-400">
            {entry.data.tech.join(" · ")}
          </p>
        </section>
      )
    }
  </article>
</BaseLayout>
