---
import { getCollection, render } from "astro:content";
import ProjectFilm from "../../components/ProjectFilm.astro";
import WorkflowDemo from "../../components/WorkflowDemo.astro";
import CaseNavigation from "../../components/CaseNavigation.astro";
import { projectDemos } from "../../data/projectDemos";
import { selectedEngineering } from "../../data/recruiter";
import ProofGrid from "../../components/ProofGrid.astro";
import SystemPath from "../../components/SystemPath.astro";
import { isPublicProject, isCaseStudy, sortProjects } from "../../lib/projects";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const projects = (await getCollection("projects")).filter(isPublicProject);
  return projects.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const engineering = selectedEngineering.find(item => item.href.startsWith(`/projects/${entry.id}/#`));
const projects = (await getCollection("projects")).filter(isPublicProject).filter(isCaseStudy).sort(sortProjects);
const nextProject = projects.length > 1 ? projects[(projects.findIndex(project => project.id === entry.id) + 1) % projects.length] : undefined;
const sections = [
  ...(entry.data.overview ? [{ id: "overview", label: "Overview" }] : []),
  ...(projectDemos[entry.id] ? [{ id: "walkthrough", label: "Example" }] : []),
  ...(entry.data.proof?.length ? [{ id: "results", label: "Results" }] : []),
  ...(entry.data.systemPath?.length ? [{ id: "architecture", label: "Architecture" }] : []),
  { id: "evidence", label: "Details & evidence" },
];
const hasHeaderResources = Boolean(
  (entry.data.privateRepo && !entry.data.status) ||
    (!entry.data.privateRepo && entry.data.github) ||
    entry.data.paper ||
    entry.data.link,
);
---

<BaseLayout
  title={`${entry.data.title} — Vraj Patel`}
  description={entry.data.summary}
  ogImage={`/og/${entry.id}.png`}
  ogImageAlt={`Project preview for ${entry.data.title}`}
  schemaType="WebPage"
  contactProject={entry.data.title}
>
  <article class="case-study">
    <a
      href="/projects/"
      class="inline-flex min-h-11 items-center text-sm underline decoration-slate-300 underline-offset-4 hover:text-blue-700 focus-visible:rounded-sm dark:decoration-slate-700 dark:hover:text-blue-400"
    >
      All projects
    </a>

    <header class="case-header">
      <p class="eyebrow">
        {entry.data.domain}
      </p>
      <h1 class="case-title" style={`view-transition-name: title-${entry.id}`}>
        {entry.data.title}
      </h1>
      {
        entry.data.summary && (
          <p class="page-lede">
            {entry.data.summary}
          </p>
        )
      }

      <div
        class:list={[
          "mt-5 flex min-h-11 flex-wrap items-center gap-x-5 gap-y-2 text-sm font-medium sm:mt-7",
          !hasHeaderResources && "hidden",
        ]}
      >
        {
          entry.data.privateRepo ? (
            !entry.data.status && (
              <span class="text-slate-500 dark:text-slate-400">Private project</span>
            )
          ) : entry.data.github && (
            <a
              href={entry.data.github}
              target="_blank"
              rel="noopener noreferrer"
              data-ph-event="outbound_link_clicked"
              data-ph-resource="github"
              data-ph-project={entry.id}
              class="inline-flex min-h-11 items-center gap-2 underline decoration-slate-300 underline-offset-4 hover:text-blue-700 focus-visible:rounded-sm dark:decoration-slate-700 dark:hover:text-blue-400"
            >
              Source
            </a>
          )
        }
        {
          entry.data.paper && (
            <a
              href={entry.data.paper}
              target="_blank"
              rel="noopener noreferrer"
              data-ph-event="outbound_link_clicked"
              data-ph-resource={entry.data.paperResource ?? "paper"}
              data-ph-project={entry.id}
              class="inline-flex min-h-11 items-center gap-2 underline decoration-slate-300 underline-offset-4 hover:text-blue-700 focus-visible:rounded-sm dark:decoration-slate-700 dark:hover:text-blue-400"
            >
              {entry.data.paperLabel ?? "Paper"}
            </a>
          )
        }
        {
          entry.data.link && (
            <a
              href={entry.data.link}
              target="_blank"
              rel="noopener noreferrer"
              data-ph-event="outbound_link_clicked"
              data-ph-resource="project_site"
              data-ph-project={entry.id}
              class="inline-flex min-h-11 items-center gap-2 underline decoration-slate-300 underline-offset-4 hover:text-blue-700 focus-visible:rounded-sm dark:decoration-slate-700 dark:hover:text-blue-400"
            >
              Visit live product <span aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span>
            </a>
          )
        }
      </div>

      <div class="case-context">
        {entry.data.status && <p class="case-status">{entry.data.status}</p>}
        {entry.data.setting && <p>{entry.data.setting}</p>}
      </div>
      <dl class="case-specification" aria-label="Engineering summary">
        {entry.data.contribution && <div>
          <dt>My role</dt>
          <dd>{entry.data.contribution}</dd>
        </div>}
        {engineering && <div>
          <dt>Engineering decision</dt>
          <dd>{engineering.title}</dd>
          <dd><a href={`#${engineering.href.split("#")[1]}`} class="text-link">Decision and evidence <span aria-hidden="true">→</span></a></dd>
        </div>}
        {entry.data.tech?.length && <div class="case-stack">
          <dt>{entry.id === "full-stack-biometric-marathon" ? "Current team stack" : "Stack"}</dt>
          <dd>{entry.data.tech.join(" · ")}</dd>
        </div>}
      </dl>
    </header>

    <div class="case-layout">
    <CaseNavigation sections={sections} />
    <div class="case-content">
    {entry.data.overview && <section id="overview" class="case-overview" aria-labelledby="overview-heading" data-reveal>
      <h2 id="overview-heading" class="section-title">The problem</h2>
      <p>{entry.data.overview.problem}</p>
    </section>}
    <div class="case-film"><ProjectFilm slug={entry.id} context="case" /></div>
    <WorkflowDemo project={entry.id} />
    {entry.data.proof?.length && <section id="results" class="page-section" aria-labelledby="project-evidence-heading">
      <h2 id="project-evidence-heading" class="section-title">Results</h2>
      <ProofGrid items={entry.data.proof} columns={3} class="mt-6" />
    </section>}
    {entry.data.systemPath?.length && <SystemPath steps={entry.data.systemPath} label={entry.data.systemPathLabel} heading={entry.data.systemPathHeading} description={entry.data.systemPathDescription} />}
    <section id="evidence" class="case-body" aria-label="Details and evidence"><Content /></section>

    {nextProject && <section class="next-case" aria-labelledby="next-case-heading">
      <p class="eyebrow">Continue exploring</p>
      <a href={`/projects/${nextProject.id}/`} class="related-project" data-ph-event="project_opened" data-ph-project={nextProject.id} data-ph-placement="related_project"><h2 id="next-case-heading">{nextProject.data.title}</h2><span aria-hidden="true">↗</span></a>
    </section>}
    </div>
    </div>
  </article>
</BaseLayout>

<style>
  .case-study { max-width: 72rem; margin-inline: auto; }
  .case-header { margin-top: 1.5rem; padding-bottom: 1.5rem; }
  .case-title { max-width: 21ch; margin-top: 1rem; font-family: var(--font-display, Georgia, serif); font-size: clamp(2.75rem, 6vw, 5rem); font-weight: 400; line-height: 1.06; letter-spacing: -.035em; color: var(--ink); text-wrap: balance; }
  .case-header > p { max-width: 64ch; }
  .case-context { margin-top: 1rem; color: var(--muted); font-size: .8125rem; line-height: 1.8; }
  .case-status { color: var(--ink); font-weight: 550; }
  .case-specification { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); margin-top: 1.5rem; border: 1px solid var(--line); border-radius: 8px; background: var(--paper-2, var(--surface)); overflow: hidden; }
  .case-specification > div { padding: 1.25rem; }
  .case-specification > div + div { border-left: 1px solid var(--line); }
  .case-specification dt { color: var(--muted); font-family: var(--font-mono); text-transform: uppercase; font-size: .65rem; letter-spacing: .09em; }
  .case-specification dd { margin-top: .5rem; color: var(--ink); font-size: .875rem; line-height: 1.75; }
  .case-specification .text-link { font-size: .75rem; }
  .case-specification > .case-stack { grid-column: 1 / -1; border-left: 0; border-top: 1px solid var(--line); }
  .case-stack dd { color: var(--copy); font-family: var(--font-mono); font-size: .75rem; }
  .case-film { margin-top: 2rem; }
  .case-layout { display: grid; grid-template-columns: minmax(0, 1fr); min-width: 0; }
  .case-content { min-width: 0; }
  .case-content :global(.page-section) { margin-top: 0; padding-block: 3.5rem 1rem; }
  .case-content :global(.case-overview) { padding-top: 2.5rem; }
  .case-content :global(#overview), .case-content :global(#walkthrough), .case-content :global(#results), .case-content :global(#architecture), .case-content :global(#evidence) { scroll-margin-top: 10rem; }
  .next-case { margin-top: 3rem; padding-block: 2rem; border-top: 1px solid var(--line); }
  .related-project { display: flex; justify-content: space-between; gap: 1rem; align-items: center; margin-top: 1.1rem; padding: 0; border: 0; color: var(--ink); }
  .related-project h2 { font-family: var(--font-display, Georgia, serif); font-weight: 400; font-size: 2rem; line-height: 1.2; }
  .related-project > span { font-size: 1.5rem; color: var(--accent); }
  .related-project:hover h2 { color: var(--accent); }
  .related-project:focus-visible { outline: 2px solid var(--accent); outline-offset: 5px; }
  @media (min-width: 1024px) {
    .case-layout { grid-template-columns: 13.5rem minmax(0, 1fr); gap: 3.5rem; align-items: start; }
    .case-content { max-width: 48rem; }
    .case-content :global(.system-step) { grid-template-columns: 2rem 1fr; }
    .case-content :global(.system-step .step-content) { grid-column: 2; }
    .case-content :global(#overview), .case-content :global(#walkthrough), .case-content :global(#results), .case-content :global(#architecture), .case-content :global(#evidence) { scroll-margin-top: 7rem; }
  }
  @media (max-width: 639px) {
    .case-header { margin-top: 1.5rem; }
    .case-specification { grid-template-columns: 1fr; }
    .case-specification > div { padding: 1rem; }
    .case-specification > div + div { border-left: 0; border-top: 1px solid var(--line); }
  }
  @media print {
    .case-layout { display: block; }
    .case-film, .next-case { display: none; }
    .case-title { font-size: 28pt; }
  }
</style>
